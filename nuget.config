<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore from nuget.org only, so every machine and CI runner resolves the same packages.
  With central package management, more than one source (for example the Visual Studio
  offline feed) raises NU1507, which TreatWarningsAsErrors turns into a failed restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
