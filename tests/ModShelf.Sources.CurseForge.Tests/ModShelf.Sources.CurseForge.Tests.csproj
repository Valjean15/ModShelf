<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\ModShelf.Sources.CurseForge\ModShelf.Sources.CurseForge.csproj" />
  </ItemGroup>

  <!-- The source's client set up as the hosts set it up: the app's retries, time limits and refusal of redirects. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ModShelf.Infrastructure\ModShelf.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Serves the recorded CurseForge answers and hand-written ones, so the tests never call CurseForge. -->
  <ItemGroup>
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>

  <!-- The checks every source shares, and the helpers several test projects use. -->
  <ItemGroup>
    <Compile Include="..\Shared\RecordingLoggerProvider.cs" Link="Shared\RecordingLoggerProvider.cs" />
    <Compile Include="..\Shared\SourceContractTests.cs" Link="Shared\SourceContractTests.cs" />
  </ItemGroup>

  <!-- The recordings Fixtures/Record-CurseForgeFixtures.ps1 makes. -->
  <ItemGroup>
    <None Include="Fixtures\Recorded\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
