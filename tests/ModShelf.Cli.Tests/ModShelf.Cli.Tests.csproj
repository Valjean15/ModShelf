<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests run the CLI as its own process, so they need its build, not its types. Referencing an
    executable copies it here with its runtimeconfig.json and deps.json, ready for "dotnet exec".
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ModShelf.Cli\ModShelf.Cli.csproj" />
  </ItemGroup>

  <!-- Test helpers several test projects share (tests/Shared). -->
  <ItemGroup>
    <Compile Include="..\Shared\MemorySchemeRegistration.cs" Link="Shared\MemorySchemeRegistration.cs" />
    <Compile Include="..\Shared\RecordingLoggerProvider.cs" Link="Shared\RecordingLoggerProvider.cs" />
    <Compile Include="..\Shared\TempFolder.cs" Link="Shared\TempFolder.cs" />
  </ItemGroup>

</Project>
