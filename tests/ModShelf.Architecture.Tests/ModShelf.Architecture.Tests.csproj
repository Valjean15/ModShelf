<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Every project under src except Desktop, the Avalonia composition root, which no rule
      restricts. Globbing means a new source project is checked without editing this file.
    -->
    <ProjectReference Include="..\..\src\*\*.csproj" Exclude="..\..\src\ModShelf.Desktop\ModShelf.Desktop.csproj" />
  </ItemGroup>

</Project>
