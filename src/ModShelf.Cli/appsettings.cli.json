{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",

      // When no keyring is running, the account commands say so themselves, in words that fit the command.
      "ModShelf.Platform.Secrets.SecretStores": "Error"
    },
    "File": {
      "LogLevel": {
        // ModShelf's own messages; the libraries it uses say only what goes wrong.
        "Default": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        // A command says in a line of its own when the library database can't be opened, a query fails, or it stops on
        // something unexpected; these errors would repeat that with SQL and stack traces, which the log files keep.
        "Microsoft.EntityFrameworkCore": "None",
        "Microsoft.Extensions.Hosting": "None",
        "ModShelf.Infrastructure.Persistence.LibraryDatabaseMigrator": "None",
        "ModShelf.Cli.Commands.GuardedAction": "None"
      }
    }
  }
}
