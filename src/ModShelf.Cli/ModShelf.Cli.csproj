<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- Composition root: references every library, for DI registration only. -->
  <ItemGroup>
    <ProjectReference Include="..\ModShelf.Application\ModShelf.Application.csproj" />
    <ProjectReference Include="..\ModShelf.Domain\ModShelf.Domain.csproj" />
    <ProjectReference Include="..\ModShelf.Infrastructure\ModShelf.Infrastructure.csproj" />
    <ProjectReference Include="..\ModShelf.Platform\ModShelf.Platform.csproj" />
    <ProjectReference Include="..\ModShelf.Presentation\ModShelf.Presentation.csproj" />
    <ProjectReference Include="..\ModShelf.Sources.Abstractions\ModShelf.Sources.Abstractions.csproj" />
    <ProjectReference Include="..\ModShelf.Sources.DirectUrl\ModShelf.Sources.DirectUrl.csproj" />
    <ProjectReference Include="..\ModShelf.Sources.Nexus\ModShelf.Sources.Nexus.csproj" />
  </ItemGroup>

  <!-- What both hosts build alike (src/Shared/Hosting). -->
  <ItemGroup>
    <Compile Include="..\Shared\Hosting\*.cs" Link="Hosting\Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
