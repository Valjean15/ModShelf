<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Strings.resx holds the English text; other cultures come from satellite assemblies (CA1824). -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModShelf.Sources.Abstractions\ModShelf.Sources.Abstractions.csproj" />
  </ItemGroup>

  <!-- The Strings class is generated from Strings.resx at build time, as in ModShelf.Presentation. -->
  <PropertyGroup>
    <CoreCompileDependsOn>PrepareResources;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ModShelf.Sources.DirectUrl.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
