<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Strings.resx holds the English text; other cultures come from satellite assemblies (CA1824). -->
    <NeutralLanguage>en</NeutralLanguage>

    <!--
      The Keychain and libsecret stores, the Windows Known Folders lookup, and the notices call the OS through
      LibraryImport, which generates the native calls at compile time and needs unsafe code for that. Windows toasts
      also call the Windows Runtime through function pointers. Only the interop classes in Secrets/, Folders/ and
      Notifications/ use it.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModShelf.Application\ModShelf.Application.csproj" />
  </ItemGroup>

  <!-- The Strings class is generated from Strings.resx at build time, as in ModShelf.Presentation. -->
  <PropertyGroup>
    <CoreCompileDependsOn>PrepareResources;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ModShelf.Platform.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
