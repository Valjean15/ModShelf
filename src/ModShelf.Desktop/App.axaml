<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounts="using:ModShelf.Presentation.ViewModels.Accounts"
             xmlns:browse="using:ModShelf.Presentation.ViewModels.Browse"
             xmlns:downloads="using:ModShelf.Presentation.ViewModels.Downloads"
             xmlns:library="using:ModShelf.Presentation.ViewModels.Library"
             xmlns:settings="using:ModShelf.Presentation.ViewModels.Settings"
             xmlns:updates="using:ModShelf.Presentation.ViewModels.Updates"
             xmlns:views="using:ModShelf.Desktop.Views"
             x:Class="ModShelf.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system's light or dark theme. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- Each screen's view, by its ViewModel: listed, not found by name, so the bindings stay compiled. -->
    <Application.DataTemplates>
        <DataTemplate DataType="library:LibraryViewModel"><views:LibraryView /></DataTemplate>
        <DataTemplate DataType="updates:UpdatesViewModel"><views:UpdatesView /></DataTemplate>
        <DataTemplate DataType="browse:BrowseViewModel"><views:BrowseView /></DataTemplate>
        <DataTemplate DataType="downloads:DownloadsViewModel"><views:DownloadsView /></DataTemplate>
        <DataTemplate DataType="accounts:AccountsViewModel"><views:AccountsView /></DataTemplate>
        <DataTemplate DataType="settings:SettingsViewModel"><views:SettingsView /></DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Shell.axaml" />
    </Application.Styles>
</Application>
