<!--
  The look of what the screens share (ADR 0046): the window, the sidebar, headings, notes and problems, cards, lists,
  pills, buttons and dialogs. Colours come from Theme.axaml, so each works in light and dark.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">

    <!-- Every window has ModShelf's icon, in its title bar and the taskbar, and the theme's background and text. -->
    <Style Selector="Window">
        <Setter Property="Icon" Value="/Assets/modshelf.png" />
        <Setter Property="Background" Value="{DynamicResource ShelfBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- A heading inside a screen, such as a game's above its mods, or a card's. -->
    <Style Selector="TextBlock.subheading">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Text that wants the user's attention without being a problem, such as updates found. -->
    <Style Selector="TextBlock.attention">
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Text that says more about what's above it, such as a folder or a status. -->
    <Style Selector=":is(TextBlock).note">
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <!-- Text that says what went wrong: after note, so a note that becomes a problem shows as one. -->
    <Style Selector=":is(TextBlock).problem">
        <Setter Property="Foreground" Value="{DynamicResource ShelfWarnBrush}" />
    </Style>

    <!-- What a command said, such as what became of a link: shown only while there's something to say. -->
    <Style Selector="TextBlock.message">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsVisible" Value="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Style>

    <!-- What a screen says while it has nothing to list, in the middle of where the list would be. -->
    <Style Selector="TextBlock.empty">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Lines of text, each after a bullet, such as a version's changes. -->
    <Style Selector="ItemsControl.bullets">
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="sys:String">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="•" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding}" />
                </Grid>
            </DataTemplate>
        </Setter>
    </Style>

    <!-- A thing of its own among others, such as a site's account, or a group of settings. -->
    <Style Selector="Border.card">
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The frame of a list of rows: a card without padding, whose rows are divided by lines. -->
    <Style Selector="Border.list">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- What went wrong, or needs the user, said once above what it's about, rather than in red lines. -->
    <Style Selector="Border.strip">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Background" Value="{DynamicResource ShelfWarnSoftBrush}" />
    </Style>

    <Style Selector="Border.strip.info">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
    </Style>

    <Style Selector="Border.strip :is(TextBlock)">
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A list of things to act on, rather than to pick from: rows stretch, divided by lines, never highlighted. -->
    <Style Selector="ListBox.rows">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.rows ListBoxItem">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- Cards stacked one above the other, such as the library's mods: no lines between them. -->
    <Style Selector="ListBox.stack">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.stack ListBoxItem">
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.stack ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.stack ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- A list whose rows are buttons, such as the mods a search found: the button pads the row instead. -->
    <Style Selector="ListBox.browse ListBoxItem">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- A row the user clicks to open, such as a mod a search found. -->
    <Style Selector="Button.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
    </Style>

    <!-- A short label beside a name, such as "Watched": a pill, plain, or coloured for what it says. -->
    <Style Selector="Border.tag">
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.tag TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <Style Selector="Border.tag.accent">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfAccentSoftBrush}" />
    </Style>

    <Style Selector="Border.tag.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.tag.good">
        <Setter Property="Background" Value="{DynamicResource ShelfGoodSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfGoodSoftBrush}" />
    </Style>

    <Style Selector="Border.tag.good TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShelfGoodBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.tag.warn">
        <Setter Property="Background" Value="{DynamicResource ShelfWarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfWarnSoftBrush}" />
    </Style>

    <Style Selector="Border.tag.warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShelfWarnBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A game's, mod's or update's site, such as "Nexus Mods", once two sites are in use: a small outlined label. -->
    <Style Selector="Border.site">
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Border.site TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <!-- One of a mod's files, in its section. -->
    <Style Selector="Border.file">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- A file kept only as an old version, in the _archive folder: on the raised colour, below the others. -->
    <Style Selector="Border.file.archived">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
    </Style>

    <!--
      A sign drawn as lines in a button, such as a tick: in the colour of the button's text, which pointing at the button
      changes. That's its template's presenter's, found up the visual tree: up the logical tree is the button's parent.
    -->
    <Style Selector="Path.line">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- What's had, such as a file in the library: a tick and a word, in the good colour. -->
    <Style Selector="StackPanel.had">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.had TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShelfGoodBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.had Path">
        <Setter Property="Stroke" Value="{DynamicResource ShelfGoodBrush}" />
        <Setter Property="StrokeThickness" Value="2.2" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <!-- Buttons: plain by default, "accent" for the one main action of a screen or row, "quiet" for the least. -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.more:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- A button that's on: soft accent, such as Watching. -->
    <Style Selector="Button.on">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfAccentTextBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <!-- A small button holding only a sign, such as copying a hash. -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <!-- A game's cover: its picture, or until it has one, its initial, large, on its colour. -->
    <Style Selector="Border.cover">
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.cover TextBlock">
        <Setter Property="Foreground" Value="#D9FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A toggle that narrows a list, such as "Has an update 2": a pill, soft accent while on. -->
    <Style Selector="ToggleButton.chip">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <!-- Tabs over a list, such as the downloads' states: pills in a row, the one picked in the accent's soft colour. -->
    <Style Selector="ListBox.tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <!-- A table's heading row, such as a game's mods' columns: small, faint and over a line. -->
    <Style Selector="Border.tableHead">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.tableHead TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShelfFaintBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A step of the way back, such as "Library" above a mod: a link in the accent colour. -->
    <Style Selector="Button.crumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style Selector="Button.crumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <!-- A mod's name that opens its page: text until pointed at, then underlined in the accent colour. -->
    <Style Selector="Button.name">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.name:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <Style Selector="Button.name:pointerover TextBlock">
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- The "…" button that holds a row's other actions. -->
    <Style Selector="Button.more">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Buttons that pick one of a few, side by side in a frame, such as a screen's previews: the one picked is raised. -->
    <Style Selector="Border.segments">
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
    </Style>

    <Style Selector="RadioButton.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Segment"
                        MinHeight="30"
                        Padding="12,0"
                        CornerRadius="7"
                        Background="{TemplateBinding Background}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="RadioButton.segment:checked /template/ Border#PART_Segment">
        <Setter Property="BoxShadow" Value="0 1 2 0 #40000000" />
    </Style>

    <!-- A segment showing an icon, such as Browse's views: narrower. -->
    <Style Selector="RadioButton.segment.icon /template/ Border#PART_Segment">
        <Setter Property="Padding" Value="9,0" />
    </Style>

    <!-- Browse's filter button: in the accent's soft colour while filters are applied. -->
    <Style Selector="Button.filters.applied /template/ ContentPresenter#PART_ContentPresenter, Button.filters.applied:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <!-- A filter applied, under Browse's search: a soft pill whose × removes it. -->
    <Style Selector="Border.filterChip">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,0,3,0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
    </Style>

    <Style Selector="Border.filterChip TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <Style Selector="Border.filterChip Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.filterChip Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <!-- The game picker's field: the chosen game's chip and what's typed, in a box that takes the accent while focused. -->
    <Style Selector="Border.pickerField">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4,3,6,3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="Cursor" Value="IBeam" />
    </Style>

    <Style Selector="Border.pickerField:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfAccentBrush}" />
    </Style>

    <!-- A text box without its own box, inside one that's drawn around it, such as the game picker's. -->
    <Style Selector="TextBox.bare">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The game chosen, as a chip in the game picker's field. -->
    <Style Selector="Border.pickedGame">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="4,2,2,2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.pickerClear">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A heading in the game picker's list, such as "Your games": small and faint. -->
    <Style Selector="TextBlock.pickerHeading">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfFaintBrush}" />
    </Style>

    <!-- A game in the game picker's list: the one Enter chooses on the raised colour. -->
    <Style Selector="Button.pickerRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.pickerRow.highlighted /template/ ContentPresenter#PART_ContentPresenter, Button.pickerRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- One of Browse's recent searches, in the game picker: a pill. -->
    <Style Selector="Button.recentSearch">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- The game picker's list in place, under its field, as in a dialog. -->
    <Style Selector="Border.pickerInline">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Height" Value="340" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- The game picker's foot: which keys do what. -->
    <Style Selector="Border.pickerKeys">
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="CornerRadius" Value="0,0,12,12" />
    </Style>

    <Style Selector="Border.pickerKeys TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfFaintBrush}" />
    </Style>

    <!-- A card over the content, such as Browse's filters: raised with a shadow. -->
    <Style Selector="Border.overCard">
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BoxShadow" Value="0 24 60 0 #59000000" />
    </Style>

    <Style Selector="Border.overCard TextBlock.label">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Quick search: the window dimmed, and the box near its top, at most 640 wide and 520 high. -->
    <Style Selector="Border.quickSearchScrim">
        <Setter Property="Background" Value="#59000000" />
    </Style>

    <Style Selector="Border.quickSearch">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="24,72,24,24" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="MaxHeight" Value="520" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.quickSearchField">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.quickSearchField PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <Style Selector="PathIcon.quickIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.quickAction">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <!-- Quick search's field at the top of the sidebar: what opens it, and its keys; collapsed, its icon alone. -->
    <Style Selector="Button.quickSearchOpen">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="8,0,8,8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <Style Selector="Button.quickSearchOpen.collapsed">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Button.quickSearchOpen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfSidebarHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="Button.quickSearchOpen.collapsed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.keyCap">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.keyCap TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfFaintBrush}" />
    </Style>

    <!-- A mod's picture: on the raised colour until it's there, with a faint sign for none. -->
    <Style Selector="Border.picture">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Path.glyph">
        <Setter Property="Stroke" Value="{DynamicResource ShelfFaintBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- What's said on a picture, such as that it's an adult mod's, blurred: white on dark, whatever the theme. -->
    <Style Selector="Border.onPicture">
        <Setter Property="Background" Value="#8C000000" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.onPicture TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A box that selects a row or a card, without text beside it. -->
    <Style Selector="CheckBox.select">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The box that selects every row shown, with its words beside it. -->
    <Style Selector="CheckBox.selectAll">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A card's box, in the top left corner of its picture. -->
    <Style Selector="Border.onPicture.box">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- A card in a row of a game's Browse page: narrower, side by side in one line. -->
    <Style Selector="Button.modCard.rowCard">
        <Setter Property="Width" Value="220" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- A mod as a card: its picture on top, then its name and what's known of it. -->
    <Style Selector="Border.modCard">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Button.modCard">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style Selector="Button.modCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfFaintBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A dialog: as tall as what it says and no more, over the main window, and not in the taskbar. -->
    <Style Selector="Window.dialog">
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="CanResize" Value="False" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="WindowStartupLocation" Value="CenterOwner" />
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
    </Style>

    <Style Selector="Window.dialog > DockPanel">
        <Setter Property="Margin" Value="24,22,24,20" />
    </Style>

    <!-- A dialog's title, above what it says, as well as in its title bar. -->
    <Style Selector="TextBlock.dialogTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- A dialog's buttons, below what it says, on the right. -->
    <Style Selector="StackPanel.dialogButtons, ItemsControl.dialogButtons">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,20,0,0" />
    </Style>

    <Style Selector="StackPanel.dialogButtons">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <!-- The sidebar: darker than the screens, its screens as quiet rows, the current one raised. -->
    <Style Selector="Button.sidebarToggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.sidebarToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfSidebarHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- The accounts at the bottom of the sidebar: in a quiet box, each a row with its round picture; collapsed, the
         pictures alone, without the box. -->
    <Style Selector="Border.accountMenu">
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource ShelfSurfaceBrush}" />
    </Style>

    <Style Selector="Border.accountMenu.collapsed">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.accountRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.accountRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfSidebarHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.avatar">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.avatar TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.avatar.link">
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.avatar.link PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <Style Selector="ListBox.sidebar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfSidebarHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.sidebar ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.sidebar ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfSidebarSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="ListBox.sidebar ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The Settings screen's categories: a quiet list, the chosen one raised. -->
    <Style Selector="ListBox.categories">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.categories ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfMutedBrush}" />
    </Style>

    <Style Selector="ListBox.categories ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="ListBox.categories ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.categories ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.categories ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.categories ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="ListBox.categories ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A category without a setting the search finds. -->
    <!-- The Games category's games: a cover, a name and what's set, the chosen one raised. -->
    <Style Selector="ListBox.games">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.games ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="ListBox.games ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="ListBox.games ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.games ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.games ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.games ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfTextBrush}" />
    </Style>

    <Style Selector="ListBox.games TextBlock.gameName">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="ListBox.games ListBoxItem:selected TextBlock.gameName">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A game's own settings, framed beside the games. -->
    <Style Selector="Border.gamePage">
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="TextBlock.settingName">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Whether a game's setting is every game's or its own: a small pill, soft accent when its own. -->
    <Style Selector="Border.pill">
        <Setter Property="BorderBrush" Value="{DynamicResource ShelfLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfFaintBrush}" />
    </Style>

    <Style Selector="Border.pill.own">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.pill.own TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShelfAccentTextBrush}" />
    </Style>

    <Style Selector="ListBox.categories TextBlock.noMatches">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource ShelfAccentBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-6,-8,0" />
    </Style>

    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ShelfOnAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
