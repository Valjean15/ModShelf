<!--
  ModShelf's icons: simple shapes on a 24 by 24 grid, drawn for ModShelf. PathIcon scales and colours them with the
  theme. "F1" fills overlapping parts (the non-zero rule); without it, an inner shape cuts a hole (even-odd).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Three lines. -->
    <StreamGeometry x:Key="MenuIcon">M3,6 H21 V8 H3 Z M3,11 H21 V13 H3 Z M3,16 H21 V18 H3 Z</StreamGeometry>

    <!-- Two books standing and one leaning, on a shelf. -->
    <StreamGeometry x:Key="LibraryIcon">M4,4 H8 V18 H4 Z M10,4 H14 V18 H10 Z M15.5,5.2 L19.4,4.2 L22.4,16.8 L18.5,17.8 Z M2,19 H22 V21 H2 Z</StreamGeometry>

    <!-- An arrow going round. -->
    <StreamGeometry x:Key="UpdatesIcon">M12,4 A8,8 0 1 0 20,12 H18 A6,6 0 1 1 12,6 V9 L16,5 L12,1 Z</StreamGeometry>

    <!-- A magnifying glass. -->
    <StreamGeometry x:Key="BrowseIcon">M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 Z M10,5 A5,5 0 1 0 10,15 A5,5 0 1 0 10,5 Z M14.6,16 L16,14.6 L21.4,20 L20,21.4 Z</StreamGeometry>

    <!-- An arrow down onto a line. -->
    <StreamGeometry x:Key="DownloadsIcon">M11,3 H13 V13 L16.5,9.5 L18,11 L12,17 L6,11 L7.5,9.5 L11,13 Z M4,19 H20 V21 H4 Z</StreamGeometry>

    <!-- A head and shoulders. -->
    <StreamGeometry x:Key="AccountsIcon">M12,3 A4,4 0 1 1 12,11 A4,4 0 1 1 12,3 Z M4,21 C4,16 7.6,13 12,13 C16.4,13 20,16 20,21 Z</StreamGeometry>

    <!-- Three dots in a row: a row's other actions. -->
    <StreamGeometry x:Key="MoreIcon">M5,10.2 A1.8,1.8 0 1 1 5,13.8 A1.8,1.8 0 1 1 5,10.2 Z M12,10.2 A1.8,1.8 0 1 1 12,13.8 A1.8,1.8 0 1 1 12,10.2 Z M19,10.2 A1.8,1.8 0 1 1 19,13.8 A1.8,1.8 0 1 1 19,10.2 Z</StreamGeometry>

    <!--
      Signs on a picture's place, drawn as lines rather than filled: Path draws them with a stroke and no fill.
    -->

    <!-- A framed landscape: where a mod's picture goes, before it's there or when it has none. -->
    <StreamGeometry x:Key="PictureGlyph">M3,5 H21 V19 H3 Z M3,16 L8,11 L12,15 L15,12 L21,17</StreamGeometry>

    <!-- An eye struck through: an adult mod's picture, hidden. -->
    <StreamGeometry x:Key="EyeOffGlyph">M3,3 L21,21 M10.6,6.1 A9.5,9.5 0 0 1 12,6 C17,6 20.5,10.5 21.5,12 A17,17 0 0 1 18.5,15.4 M6.5,7.6 A16,16 0 0 0 2.5,12 C3.5,13.5 7,18 12,18 A9,9 0 0 0 16,17.1</StreamGeometry>

    <!-- A tick: something done or had, such as a mod watched. -->
    <StreamGeometry x:Key="CheckGlyph">M5,12 L10,17 L19,7</StreamGeometry>

    <!-- An arrow out of a box: a page that opens outside the app. -->
    <StreamGeometry x:Key="ExternalGlyph">M14,4 H20 V10 M20,4 L11,13 M18,14 V19 A1,1 0 0 1 17,20 H5 A1,1 0 0 1 4,19 V7 A1,1 0 0 1 5,6 H10</StreamGeometry>

    <!-- Two sheets, one over the other: copying. -->
    <StreamGeometry x:Key="CopyGlyph">M9,9 H20 V20 H9 Z M5,15 H4 V4 H15 V5</StreamGeometry>

    <!-- Two sliders. -->
    <StreamGeometry x:Key="SettingsIcon">F1 M3,6 H21 V8 H3 Z M3,16 H21 V18 H3 Z M7,4 H10 V10 H7 Z M14,14 H17 V20 H14 Z</StreamGeometry>

    <!-- Three lines, each shorter: a funnel of filters. -->
    <StreamGeometry x:Key="FilterIcon">M4,5 H20 V7 H4 Z M7,11 H17 V13 H7 Z M10,17 H14 V19 H10 Z</StreamGeometry>

    <!-- A cross: closing or removing. -->
    <StreamGeometry x:Key="CloseIcon">F1 M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z</StreamGeometry>

    <!-- The views of a list of mods: rows, rows with a thumbnail each, and cards. -->
    <StreamGeometry x:Key="RowsIcon">M4,5 H20 V7 H4 Z M4,11 H20 V13 H4 Z M4,17 H20 V19 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="ThumbnailsIcon">M4,5 H9 V10 H4 Z M11,6.5 H20 V8.5 H11 Z M4,14 H9 V19 H4 Z M11,15.5 H20 V17.5 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="CardsIcon">M4,4 H11 V11 H4 Z M13,4 H20 V11 H13 Z M4,13 H11 V20 H4 Z M13,13 H20 V20 H13 Z</StreamGeometry>

    <!-- Link an account, at the bottom of the sidebar. -->
    <StreamGeometry x:Key="PlusIcon">M11,4 H13 V11 H20 V13 H13 V20 H11 V13 H4 V11 H11 Z</StreamGeometry>
</ResourceDictionary>
