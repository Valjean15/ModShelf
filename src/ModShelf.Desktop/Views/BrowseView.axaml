<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Browse"
             xmlns:res="using:ModShelf.Presentation.Resources"
             xmlns:views="using:ModShelf.Desktop.Views"
             xmlns:games="using:ModShelf.Desktop.Views.Games"
             xmlns:pictures="using:ModShelf.Desktop.Views.Pictures"
             xmlns:modPages="using:ModShelf.Desktop.Views.ModPages"
             x:Class="ModShelf.Desktop.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">

    <UserControl.Styles>
        <Style Selector="StackPanel.stripButtons">
            <Setter Property="Grid.Column" Value="1" />
        </Style>
    </UserControl.Styles>

    <DockPanel Container.Name="BrowseScreen" Container.Sizing="Width">
        <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{Binding Title}" />

        <!-- The game, and the mods the account follows on its site. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
            <games:GamePicker DataContext="{Binding Picker}" />
            <Button Grid.Column="2" Content="{Binding ShowFollowedText}" Command="{Binding ShowTrackedCommand}" IsVisible="{Binding CanFollow}" />
        </Grid>

        <!-- What to look for: words, or a link to a mod; the filter card, which counts the filters applied; the view. -->
        <Grid DockPanel.Dock="Top" Classes="searchRow" Margin="0,10,0,0" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
            <!-- Narrow: the words get the whole row, the buttons go under them. On the row rather than the screen: a container query
                 watches every control within its reach, a page of cards too (ADR 0084). -->
            <Grid.Styles>
                <ContainerQuery Name="BrowseScreen" Query="max-width:620">
                    <Style Selector="TextBox.searchWords">
                        <Setter Property="Grid.ColumnSpan" Value="4" />
                    </Style>
                    <Style Selector="Grid.searchRow > :is(Control).searchTool">
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Margin" Value="0,8,0,0" />
                    </Style>
                </ContainerQuery>
            </Grid.Styles>
            <TextBox Classes="searchWords" Text="{Binding SearchText}" PlaceholderText="{x:Static res:Strings.BrowseSearchHint}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1"
                    Classes="accent searchTool"
                    Content="{x:Static res:Strings.BrowseSearch}"
                    Command="{Binding SearchCommand}" />
            <Button Grid.Column="2"
                    Classes="filters searchTool"
                    Classes.applied="{Binding HasChips}"
                    Command="{Binding ToggleFiltersCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="16" Height="16" Data="{StaticResource FilterIcon}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding FiltersText}" />
                </StackPanel>
            </Button>
            <pictures:ViewSwitch Grid.Column="3" Classes="searchTool" VerticalAlignment="Center" DataContext="{Binding Previews}" />
        </Grid>

        <!-- A chip per filter applied: its × removes it at once, and Clear all removes them all. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,10,0,0" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding HasChips}">
            <ItemsControl ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrowseFilterChipViewModel">
                        <Border Classes="filterChip">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Label}" />
                                <Button Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="{Binding RemoveLabel}"
                                        AutomationProperties.Name="{Binding RemoveLabel}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource CloseIcon}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="quiet"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Strings.BrowseFiltersClearAll}"
                    Command="{Binding ClearFiltersCommand}" />
        </WrapPanel>

        <Panel DockPanel.Dock="Top" Margin="0,12,0,0">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsReadingGames}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </Panel>

        <!-- What went wrong, with what the user can do about it. -->
        <Border DockPanel.Dock="Top"
                Classes="strip"
                Margin="0,8,0,0"
                IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Problem}" />
                <StackPanel Classes="stripButtons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Narrow: a problem's buttons go under it. -->
                    <StackPanel.Styles>
                        <ContainerQuery Name="BrowseScreen" Query="max-width:620">
                            <Style Selector="StackPanel.stripButtons">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Margin" Value="0,8,0,0" />
                            </Style>
                        </ContainerQuery>
                    </StackPanel.Styles>
                    <Button Content="{x:Static res:Strings.BrowseGoToAccounts}"
                            Command="{Binding GoToAccountsCommand}"
                            IsVisible="{Binding NeedsAccount}" />
                    <Button Content="{x:Static res:Strings.BrowseRetry}"
                            Command="{Binding ReadGamesCommand}"
                            IsVisible="{Binding IsGamesProblem}" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel Margin="0,12,0,0">
            <!-- A game's rows before a search: its trending, newest and recently updated mods. Clicking a mod opens it. -->
            <ScrollViewer>
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsShowingRows" />
                        <Binding Path="!IsModOpen" />
                    </MultiBinding>
                </ScrollViewer.IsVisible>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,16,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BrowseRowViewModel">
                            <StackPanel Spacing="8" IsVisible="{Binding IsShown}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Classes="quiet"
                                            Content="{x:Static res:Strings.BrowseRowShowAll}"
                                            Command="{Binding ShowAllCommand}"
                                            IsVisible="{Binding CanShowAll}" />
                                    <TextBlock Classes="subheading" VerticalAlignment="Center" Text="{Binding Title}" />
                                </DockPanel>
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                                <TextBlock Classes="problem"
                                           TextWrapping="Wrap"
                                           Text="{Binding Problem}"
                                           IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="note" Text="{x:Static res:Strings.BrowseRowEmpty}" IsVisible="{Binding IsEmpty}" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Mods}" Margin="0,0,0,12">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="14" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BrowseModViewModel">
                                                <Button Classes="modCard rowCard" Command="{Binding OpenCommand}">
                                                    <DockPanel>
                                                        <Panel DockPanel.Dock="Top" IsVisible="{Binding Picture.IsShown}">
                                                            <pictures:ModCardPicture DataContext="{Binding Picture}" />
                                                        </Panel>
                                                        <StackPanel Margin="12,10,12,12" Spacing="3">
                                                            <TextBlock FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding Name}" />
                                                            <TextBlock Classes="note"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding AuthorText}"
                                                                       IsVisible="{Binding AuthorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                            <TextBlock Classes="note" Text="{Binding FactText}" IsVisible="{Binding FactText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                            <TextBlock Classes="note" Text="{Binding EndorsementsText}" />
                                                            <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,2,0,0">
                                                                <Border Classes="tag good" IsVisible="{Binding IsDownloaded}">
                                                                    <TextBlock Text="{x:Static res:Strings.BrowseDownloadedTag}" />
                                                                </Border>
                                                                <Border Classes="tag" IsVisible="{Binding IsWatched}">
                                                                    <TextBlock Text="{x:Static res:Strings.BrowseWatchedTag}" />
                                                                </Border>
                                                                <Border Classes="tag" IsVisible="{Binding IsHidden}">
                                                                    <TextBlock Text="{x:Static res:Strings.BrowseHiddenTag}" />
                                                                </Border>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The search's results, or the tracked mods. Clicking a mod opens it. -->
            <DockPanel>
                <DockPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsShowingRows" />
                        <Binding Path="!IsModOpen" />
                    </MultiBinding>
                </DockPanel.IsVisible>
                <!-- How many match; selecting the mods listed, and what to do with those selected. -->
                <WrapPanel DockPanel.Dock="Top" ItemSpacing="12" LineSpacing="8">
                    <CheckBox Classes="selectAll"
                              IsChecked="{Binding AreAllShownSelected}"
                              Content="{x:Static res:Strings.SelectAllShown}"
                              IsVisible="{Binding !!Results.Count}" />
                    <TextBlock Classes="note" VerticalAlignment="Center" Text="{Binding ResultsText}" />
                    <TextBlock Classes="note"
                               VerticalAlignment="Center"
                               Text="{Binding OrderText}"
                               IsVisible="{Binding OrderText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Content="{Binding WatchAllText}" Command="{Binding WatchAllCommand}" IsVisible="{Binding IsShowingTracked}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="note" VerticalAlignment="Center" Text="{Binding SelectionText}" />
                        <Button Classes="accent" Content="{Binding DownloadSelectedText}" Command="{Binding DownloadSelectedCommand}" />
                        <Button Classes="quiet" Content="{x:Static res:Strings.SelectionClear}" Command="{Binding ClearSelectionCommand}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top"
                           Classes="note message"
                           Classes.problem="{Binding IsSelectionNoteAProblem}"
                           Margin="0,6,0,0"
                           Text="{Binding SelectionNote}" />
                <Button DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Content="{x:Static res:Strings.BrowseLoadMore}"
                        Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding HasMore}" />

                <Panel>
                    <Border Classes="list" VerticalAlignment="Top" Margin="0,8,0,0">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!!Results.Count" />
                                <Binding Path="Previews.ShowsRows" />
                            </MultiBinding>
                        </Border.IsVisible>
                        <ListBox Classes="rows browse" ItemsSource="{Binding Results}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BrowseModViewModel">
                                    <Button Classes="row" Command="{Binding OpenCommand}">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <CheckBox Classes="select"
                                                      Margin="0,0,14,0"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      AutomationProperties.Name="{Binding SelectText}" />
                                            <!-- Its thumbnail, while the screen shows them. -->
                                            <Panel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Top" IsVisible="{Binding Picture.IsShown}">
                                                <pictures:ModThumbnail DataContext="{Binding Picture}" />
                                            </Panel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <WrapPanel ItemSpacing="8">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Classes="note" Text="{Binding AuthorText}" />
                                                    <Border Classes="tag good" IsVisible="{Binding IsDownloaded}">
                                                        <TextBlock Text="{x:Static res:Strings.BrowseDownloadedTag}" />
                                                    </Border>
                                                    <Border Classes="tag" IsVisible="{Binding IsWatched}">
                                                        <TextBlock Text="{x:Static res:Strings.BrowseWatchedTag}" />
                                                    </Border>
                                                    <Border Classes="tag" IsVisible="{Binding HasAdultContent}">
                                                        <TextBlock Text="{x:Static res:Strings.BrowseAdultTag}" />
                                                    </Border>
                                                    <Border Classes="tag" IsVisible="{Binding IsHidden}">
                                                        <TextBlock Text="{x:Static res:Strings.BrowseHiddenTag}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Summary}"
                                                           IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <WrapPanel ItemSpacing="16">
                                                    <TextBlock Classes="note" Text="{Binding FactText}" IsVisible="{Binding FactText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Classes="note" Text="{Binding VersionText}" />
                                                    <TextBlock Classes="note" Text="{Binding UpdatedText}" />
                                                    <TextBlock Classes="note" Text="{Binding DownloadsText}" />
                                                    <TextBlock Classes="note" Text="{Binding EndorsementsText}" />
                                                </WrapPanel>
                                                <TextBlock Classes="problem"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Problem}"
                                                           IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- As cards, as many side by side as fit. Clicking one opens it. -->
                    <ScrollViewer Margin="0,8,0,0" IsVisible="{Binding Previews.IsCards}">
                        <ItemsControl ItemsSource="{Binding Results}" Margin="0,0,16,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid ColumnSpacing="16"
                                                 RowSpacing="16"
                                                 Columns="{Binding $parent[ScrollViewer].Bounds.Width, Converter={x:Static views:CardColumnsConverter.Instance}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BrowseModViewModel">
                                    <Button Classes="modCard" Command="{Binding OpenCommand}">
                                        <DockPanel>
                                            <Panel DockPanel.Dock="Top">
                                                <pictures:ModCardPicture DataContext="{Binding Picture}" />
                                                <Border Classes="onPicture box" IsVisible="{Binding CanSelect}">
                                                    <CheckBox Classes="select"
                                                              IsChecked="{Binding IsSelected}"
                                                              AutomationProperties.Name="{Binding SelectText}" />
                                                </Border>
                                            </Panel>
                                            <StackPanel Margin="14,10,14,14" Spacing="4">
                                                <TextBlock FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Name}" />
                                                <TextBlock Classes="note" Text="{Binding AuthorText}" IsVisible="{Binding AuthorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Classes="note"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Summary}"
                                                           IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Classes="note" Text="{Binding FactText}" IsVisible="{Binding FactText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <WrapPanel ItemSpacing="12">
                                                    <TextBlock Classes="note" Text="{Binding EndorsementsText}" />
                                                    <TextBlock Classes="note" Text="{Binding DownloadsText}" />
                                                </WrapPanel>
                                                <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,2,0,0">
                                                    <Border Classes="tag good" IsVisible="{Binding IsDownloaded}">
                                                        <TextBlock Text="{x:Static res:Strings.BrowseDownloadedTag}" />
                                                    </Border>
                                                    <Border Classes="tag" IsVisible="{Binding IsWatched}">
                                                        <TextBlock Text="{x:Static res:Strings.BrowseWatchedTag}" />
                                                    </Border>
                                                    <Border Classes="tag" IsVisible="{Binding IsHidden}">
                                                        <TextBlock Text="{x:Static res:Strings.BrowseHiddenTag}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Classes="problem"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Problem}"
                                                           IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>

            <!-- The mod opened, in place of the list. -->
            <DockPanel IsVisible="{Binding IsModOpen}">
                <Button DockPanel.Dock="Top"
                        Classes="quiet"
                        HorizontalAlignment="Left"
                        Content="{x:Static res:Strings.BrowseBack}"
                        Command="{Binding BackCommand}" />

                <ScrollViewer Margin="0,12,0,0">
                    <modPages:ModPageView Margin="0,0,16,16" DataContext="{Binding Mod}" />
                </ScrollViewer>
            </DockPanel>

            <!-- The filter card, over the results on the right: only what the game's site can search by. Its choices
                 apply with Apply; Close and Escape leave what was applied. -->
            <Border x:Name="FilterCard"
                    Classes="overCard"
                    Width="380"
                    MaxWidth="{Binding $parent[Panel].Bounds.Width}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsVisible="{Binding Filters.IsOpen}">
                <Border.KeyBindings>
                    <KeyBinding Gesture="Escape" Command="{Binding Filters.CloseCommand}" />
                </Border.KeyBindings>
                <Panel DataContext="{Binding Filters}">
                    <DockPanel x:DataType="vm:BrowseFiltersViewModel">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,14,12,8">
                            <TextBlock Classes="subheading" Margin="0" VerticalAlignment="Center" Text="{x:Static res:Strings.BrowseFilters}" />
                            <Button Grid.Column="1"
                                    Classes="quiet"
                                    Command="{Binding CloseCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.BrowseFiltersCloseHint}"
                                    AutomationProperties.Name="{x:Static res:Strings.BrowseFiltersCloseHint}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource CloseIcon}" />
                            </Button>
                        </Grid>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource ShelfLineBrush}" BorderThickness="0,1,0,0" Padding="20,14,20,16">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Button Classes="quiet" Content="{x:Static res:Strings.BrowseFiltersReset}" Command="{Binding ResetCommand}" />
                                <Button Grid.Column="2" Content="{x:Static res:Strings.BrowseFiltersClose}" Command="{Binding CloseCommand}" />
                                <Button Grid.Column="3" Classes="accent" Content="{x:Static res:Strings.BrowseFiltersApply}" Command="{Binding ApplyCommand}" />
                            </Grid>
                        </Border>
                        <ScrollViewer MaxHeight="560">
                            <StackPanel Margin="20,4,20,18" Spacing="16">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="{x:Static res:Strings.BrowseFilterOrder}" />
                                    <ComboBox x:Name="FirstFilter"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Sorts}"
                                              SelectedItem="{Binding SelectedSort}"
                                              AutomationProperties.Name="{x:Static res:Strings.BrowseFilterOrder}" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding CanSearchByUpdated}">
                                    <TextBlock Classes="label" Text="{x:Static res:Strings.BrowseFilterUpdated}" />
                                    <ListBox Classes="tabs"
                                             AutoScrollToSelectedItem="False"
                                             ItemsSource="{Binding TimeWindows}"
                                             SelectedItem="{Binding SelectedTimeWindow}"
                                             AutomationProperties.Name="{x:Static res:Strings.BrowseFilterUpdated}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimeWindowChoice">
                                                <TextBlock Text="{Binding ShortName}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding CanSearchByCategory}">
                                    <TextBlock Classes="label" Text="{x:Static res:Strings.BrowseFilterCategory}" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Categories}"
                                              SelectedItem="{Binding SelectedCategory}"
                                              AutomationProperties.Name="{x:Static res:Strings.BrowseFilterCategory}" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding CanSearchByAuthor}">
                                    <TextBlock Classes="label" Text="{x:Static res:Strings.BrowseFilterAuthor}" />
                                    <TextBox Text="{Binding Author}"
                                             PlaceholderText="{x:Static res:Strings.BrowseFilterAuthorHint}"
                                             AutomationProperties.Name="{x:Static res:Strings.BrowseFilterAuthor}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                                <CheckBox Content="{x:Static res:Strings.BrowseAdultContent}"
                                          IsChecked="{Binding IncludeAdultContent}"
                                          IsVisible="{Binding CanIncludeAdult}" />
                                <StackPanel>
                                    <TextBlock Classes="label" Text="{x:Static res:Strings.BrowseFilterPageSize}" />
                                    <ListBox Classes="tabs"
                                             AutoScrollToSelectedItem="False"
                                             ItemsSource="{Binding PageSizes}"
                                             SelectedItem="{Binding SelectedPageSize}"
                                             AutomationProperties.Name="{x:Static res:Strings.BrowseFilterPageSize}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PageSizeChoice">
                                                <TextBlock Text="{Binding Count}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Panel>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
