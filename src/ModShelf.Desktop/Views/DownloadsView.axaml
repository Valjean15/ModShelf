<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Downloads"
             xmlns:res="using:ModShelf.Presentation.Resources"
             xmlns:pictures="using:ModShelf.Desktop.Views.Pictures"
             x:Class="ModShelf.Desktop.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">

    <!--
      The previews beside the heading; in a narrow window, below it. Their place is set here rather than on them, so the
      narrow window's can replace it.
    -->
    <UserControl.Styles>
        <Style Selector="pictures|PreviewsPicker#Previews">
            <Setter Property="Grid.Column" Value="1" />
        </Style>
        <ContainerQuery Name="DownloadsScreen" Query="max-width:560">
            <Style Selector="pictures|PreviewsPicker#Previews">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <DockPanel Container.Name="DownloadsScreen" Container.Sizing="Width">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
            <TextBlock Classes="heading" Text="{Binding Title}" />
            <pictures:PreviewsPicker Name="Previews"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     DataContext="{Binding Previews}" />
            <Button Grid.Column="2"
                    Classes="quiet"
                    VerticalAlignment="Top"
                    Content="{x:Static res:Strings.DownloadsClearFinished}"
                    Command="{Binding ClearFinishedCommand}" />
        </Grid>

        <!-- A link goes into the library, or into a folder the user picks. Enter downloads it into the library. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Name="LinkBox"
                     Text="{Binding Link}"
                     PlaceholderText="{x:Static res:Strings.DownloadsLinkHint}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1"
                    Classes="accent"
                    Content="{x:Static res:Strings.DownloadsAdd}"
                    Command="{Binding AddCommand}" />
            <Button Grid.Column="2"
                    Content="{x:Static res:Strings.SaveToFolder}"
                    Command="{Binding AddToFolderCommand}" />
        </Grid>

        <!-- While another process, such as the command line, runs the downloads. -->
        <Border DockPanel.Dock="Top" Classes="strip info" Margin="0,12,0,0" IsVisible="{Binding IsQueueBusyElsewhere}">
            <TextBlock Text="{x:Static res:Strings.DownloadsQueueBusy}" />
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Classes="note message"
                   Classes.problem="{Binding IsMessageAProblem}"
                   Margin="0,8,0,0"
                   Text="{Binding Message}" />

        <Panel Margin="0,16,0,0">
            <TextBlock Classes="note empty"
                       Text="{x:Static res:Strings.DownloadsEmpty}"
                       IsVisible="{Binding !HasJobs}" />

            <!-- A row's buttons sit beside its name, so what it says below has the row's whole width. -->
            <Border Classes="list" VerticalAlignment="Top" IsVisible="{Binding HasJobs}">
                <ListBox Classes="rows" ItemsSource="{Binding Jobs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DownloadJobViewModel">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- Its mod's thumbnail, while the screen shows them. -->
                                <Panel Margin="0,0,14,0" VerticalAlignment="Top" IsVisible="{Binding Picture.IsShown}">
                                    <pictures:ModThumbnail DataContext="{Binding Picture}" />
                                </Panel>
                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="4">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Classes="note"
                                               TextTrimming="PathSegmentEllipsis"
                                               Text="{Binding Folder}"
                                               ToolTip.Tip="{Binding Folder}" />
                                    <ProgressBar Grid.Row="2"
                                                 Grid.ColumnSpan="2"
                                                 Margin="0,4"
                                                 Maximum="100"
                                                 Value="{Binding Progress}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="note"
                                                   Classes.problem="{Binding IsFailed}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding StatusText}" />
                                        <TextBlock Grid.Column="1" Classes="note" Text="{Binding SizeText}" />
                                        <TextBlock Grid.Column="2" Classes="note" Text="{Binding SpeedText}" />
                                    </Grid>

                                    <!-- A download waiting for the user says what to do, and holds the buttons to do it. -->
                                    <StackPanel Grid.Row="4"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Margin="0,6,0,0"
                                                IsVisible="{Binding IsAwaitingHandoff}">
                                        <Button Classes="accent" Content="{Binding OpenPageLabel}" Command="{Binding OpenPageCommand}" />
                                        <Button Content="{x:Static res:Strings.JobPasteLink}" Command="{Binding PasteLinkCommand}" />
                                    </StackPanel>

                                    <!-- Only what the download allows now shows. -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="{x:Static res:Strings.JobPause}"
                                                Command="{Binding PauseCommand}"
                                                IsVisible="{Binding CanPause}" />
                                        <Button Content="{x:Static res:Strings.JobResume}"
                                                Command="{Binding ResumeCommand}"
                                                IsVisible="{Binding CanResume}" />
                                        <Button Content="{x:Static res:Strings.JobRetry}"
                                                Command="{Binding RetryCommand}"
                                                IsVisible="{Binding CanRetry}" />
                                        <Button Classes="quiet"
                                                Content="{x:Static res:Strings.JobCancel}"
                                                Command="{Binding CancelCommand}"
                                                IsVisible="{Binding CanCancel}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
