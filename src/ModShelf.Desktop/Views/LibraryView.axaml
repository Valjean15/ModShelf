<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Library"
             xmlns:res="using:ModShelf.Presentation.Resources"
             xmlns:views="using:ModShelf.Desktop.Views"
             xmlns:pictures="using:ModShelf.Desktop.Views.Pictures"
             xmlns:modPages="using:ModShelf.Desktop.Views.ModPages"
             x:Class="ModShelf.Desktop.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <!--
      The previews at the end of the filter's row, or of the way back from a mod; in a narrow window, below them. Their
      places are set here rather than on them, so the narrow window's can replace them.
    -->
    <UserControl.Styles>
        <Style Selector="pictures|PreviewsPicker#Previews">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="pictures|PreviewsPicker#PagePreviews">
            <Setter Property="Grid.Column" Value="1" />
        </Style>
        <ContainerQuery Name="LibraryScreen" Query="max-width:540">
            <Style Selector="pictures|PreviewsPicker#Previews, pictures|PreviewsPicker#PagePreviews">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <Panel Container.Name="LibraryScreen" Container.Sizing="Width">
        <DockPanel IsVisible="{Binding !IsModOpen}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                <TextBlock Classes="heading" Text="{Binding Title}" />
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Content="{x:Static res:Strings.LibraryRescan}"
                        Command="{Binding RescanCommand}"
                        IsVisible="{Binding !IsEmpty}" />
            </Grid>

            <!-- The filter as wide as the screen allows, up to a comfortable width; the previews at the end. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12" ColumnSpacing="12" RowDefinitions="Auto,Auto" IsVisible="{Binding !IsEmpty}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" MaxWidth="420" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Filter}" PlaceholderText="{x:Static res:Strings.LibraryFilterHint}" />
                <pictures:PreviewsPicker Name="Previews" HorizontalAlignment="Left" DataContext="{Binding Previews}" />
            </Grid>

            <Panel>
                <TextBlock Classes="note empty"
                           Text="{x:Static res:Strings.LibraryEmpty}"
                           IsVisible="{Binding IsEmpty}" />
                <TextBlock Classes="note empty"
                           Text="{Binding NothingMatchesText}"
                           IsVisible="{Binding NothingMatches}" />

                <!-- One list of games' headings and their mods, so it's virtualized. Each mod is a card of its own. -->
                <ListBox Classes="stack"
                         ItemsSource="{Binding Rows}"
                         IsVisible="{Binding Previews.ShowsRows}">
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="vm:LibraryGameViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,4">
                                <TextBlock Classes="subheading" Text="{Binding Name}" />
                                <TextBlock Classes="note" VerticalAlignment="Bottom" Text="{Binding ModsText}" />
                            </StackPanel>
                        </DataTemplate>

                        <DataTemplate DataType="vm:LibraryModViewModel">
                            <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Its thumbnail, while the screen shows them. -->
                                        <Panel Margin="0,0,14,0" VerticalAlignment="Center" IsVisible="{Binding Picture.IsShown}">
                                            <pictures:ModThumbnail DataContext="{Binding Picture}" />
                                        </Panel>

                                        <!-- Wrapping, so long names go to the next line rather than under the button. -->
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0" Spacing="3" VerticalAlignment="Center">
                                            <WrapPanel ItemSpacing="8">
                                                <Button Classes="name" Command="{Binding OpenCommand}">
                                                    <TextBlock TextWrapping="Wrap" Text="{Binding Name}" />
                                                </Button>
                                                <TextBlock Classes="note" Text="{Binding AuthorText}" />
                                            </WrapPanel>
                                            <WrapPanel ItemSpacing="14" LineSpacing="4">
                                                <TextBlock Classes="note" VerticalAlignment="Center" Text="{Binding WatchedText}" />
                                                <TextBlock Classes="note" VerticalAlignment="Center" Text="{Binding FilesText}" />
                                                <Border Classes="tag accent" IsVisible="{Binding HasUpdates}">
                                                    <TextBlock Text="{Binding UpdatesText}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- The mod's actions, in one menu, so the list stays quiet. -->
                                        <Button Grid.Column="2"
                                                Classes="more"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{x:Static res:Strings.MoreActions}"
                                                AutomationProperties.Name="{x:Static res:Strings.MoreActions}">
                                            <PathIcon Width="18" Height="18" Data="{StaticResource MoreIcon}" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="{x:Static res:Strings.LibraryOpenMod}" Command="{Binding OpenCommand}" />
                                                    <MenuItem Header="{x:Static res:Strings.LibraryOpenOnSite}" Command="{Binding OpenPageCommand}" />
                                                    <MenuItem Header="{x:Static res:Strings.LibraryOpenFolder}" Command="{Binding OpenFolderCommand}" />
                                                    <MenuItem Header="{x:Static res:Strings.ModWatch}" Command="{Binding WatchCommand}" IsVisible="{Binding !IsWatched}" />
                                                    <MenuItem Header="{x:Static res:Strings.ModUnwatch}" Command="{Binding UnwatchCommand}" IsVisible="{Binding IsWatched}" />
                                                    <MenuItem Header="{x:Static res:Strings.LibraryRescan}" Command="{Binding RescanCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="{x:Static res:Strings.LibraryRemoveMod}" Command="{Binding RemoveCommand}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LibraryFileViewModel">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" />
                                                    <WrapPanel ItemSpacing="14">
                                                        <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding Name}" />
                                                        <TextBlock Classes="note" Text="{Binding VersionText}" />
                                                        <TextBlock Classes="note" Text="{Binding SizeText}" />
                                                        <TextBlock Classes="note" Text="{Binding DownloadedText}" />
                                                    </WrapPanel>
                                                    <!-- Selectable, so the hash can be copied to check a copy of the file. -->
                                                    <SelectableTextBlock Classes="note"
                                                                         FontFamily="{DynamicResource ShelfMonoFont}"
                                                                         FontSize="12.5"
                                                                         TextWrapping="Wrap"
                                                                         Text="{Binding Sha256Text}"
                                                                         IsVisible="{Binding Sha256Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Classes="quiet"
                                                        VerticalAlignment="Center"
                                                        Content="{x:Static res:Strings.LibraryDeleteFile}"
                                                        Command="{Binding DeleteCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>

                <!-- As cards: each game's heading, then its mods' cards, as many side by side as fit. -->
                <ScrollViewer Name="Cards" IsVisible="{Binding Previews.IsCards}">
                    <ItemsControl ItemsSource="{Binding Games}" Margin="0,0,16,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryGameViewModel">
                                <StackPanel Spacing="10" Margin="0,14,0,6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="subheading" Text="{Binding Name}" />
                                        <TextBlock Classes="note" VerticalAlignment="Bottom" Text="{Binding ModsText}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Mods}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid ColumnSpacing="16"
                                                             RowSpacing="16"
                                                             Columns="{Binding $parent[ScrollViewer].Bounds.Width, Converter={x:Static views:CardColumnsConverter.Instance}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LibraryModViewModel">
                                                <Border Classes="modCard">
                                                    <DockPanel>
                                                        <pictures:ModCardPicture DockPanel.Dock="Top" DataContext="{Binding Picture}" />
                                                        <StackPanel Margin="14,10,6,14" Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                                <Button Classes="name" VerticalAlignment="Center" Command="{Binding OpenCommand}">
                                                                    <TextBlock FontSize="15"
                                                                               TextWrapping="Wrap"
                                                                               MaxLines="2"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding Name}" />
                                                                </Button>
                                                                <Button Grid.Column="1"
                                                                        Classes="more"
                                                                        VerticalAlignment="Top"
                                                                        ToolTip.Tip="{x:Static res:Strings.MoreActions}"
                                                                        AutomationProperties.Name="{x:Static res:Strings.MoreActions}">
                                                                    <PathIcon Width="18" Height="18" Data="{StaticResource MoreIcon}" />
                                                                    <Button.Flyout>
                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                            <MenuItem Header="{x:Static res:Strings.LibraryOpenMod}" Command="{Binding OpenCommand}" />
                                                                            <MenuItem Header="{x:Static res:Strings.LibraryOpenOnSite}" Command="{Binding OpenPageCommand}" />
                                                                            <MenuItem Header="{x:Static res:Strings.LibraryOpenFolder}" Command="{Binding OpenFolderCommand}" />
                                                                            <MenuItem Header="{x:Static res:Strings.ModWatch}" Command="{Binding WatchCommand}" IsVisible="{Binding !IsWatched}" />
                                                                            <MenuItem Header="{x:Static res:Strings.ModUnwatch}" Command="{Binding UnwatchCommand}" IsVisible="{Binding IsWatched}" />
                                                                            <MenuItem Header="{x:Static res:Strings.LibraryRescan}" Command="{Binding RescanCommand}" />
                                                                            <Separator />
                                                                            <MenuItem Header="{x:Static res:Strings.LibraryRemoveMod}" Command="{Binding RemoveCommand}" />
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                            <TextBlock Classes="note" Text="{Binding AuthorText}" IsVisible="{Binding AuthorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                            <WrapPanel ItemSpacing="12">
                                                                <TextBlock Classes="note" Text="{Binding WatchedText}" />
                                                                <TextBlock Classes="note" Text="{Binding FilesText}" />
                                                            </WrapPanel>
                                                            <Border Classes="tag accent" HorizontalAlignment="Left" Margin="0,2,0,0" IsVisible="{Binding HasUpdates}">
                                                                <TextBlock Text="{Binding UpdatesText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>

        <!-- The mod opened, in place of the list: the way back, then its page. -->
        <DockPanel IsVisible="{Binding IsModOpen}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <WrapPanel VerticalAlignment="Center" ItemSpacing="4" LineSpacing="4">
                    <Button Classes="crumb" Content="{Binding Title}" Command="{Binding BackCommand}" />
                    <TextBlock Classes="note" VerticalAlignment="Center" Text="›" />
                    <Button Classes="crumb" Content="{Binding OpenGameName}" Command="{Binding BackCommand}" />
                    <TextBlock Classes="note" VerticalAlignment="Center" Text="›" />
                    <TextBlock Classes="note" VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="Wrap" Text="{Binding Mod.Name, FallbackValue=''}" />
                </WrapPanel>
                <pictures:PreviewsPicker Name="PagePreviews" HorizontalAlignment="Left" DataContext="{Binding Previews}" />
            </Grid>

            <!-- Why the site's details aren't shown, with a way to ask again. -->
            <Border DockPanel.Dock="Top"
                    Classes="strip"
                    Margin="0,0,0,16"
                    IsVisible="{Binding PageProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{Binding PageProblem}" />
                    <Button Grid.Column="1" Content="{x:Static res:Strings.BrowseRetry}" Command="{Binding RetryCommand}" />
                </Grid>
            </Border>

            <ScrollViewer>
                <modPages:ModPageView Margin="0,0,16,16" DataContext="{Binding Mod}" />
            </ScrollViewer>
        </DockPanel>

        <!-- While a mod is read from its site, over the top of what's shown, so nothing moves. -->
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" IsVisible="{Binding IsOpening}" />
    </Panel>
</UserControl>
