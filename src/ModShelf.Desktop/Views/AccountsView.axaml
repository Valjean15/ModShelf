<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Accounts"
             xmlns:views="using:ModShelf.Desktop.Views"
             xmlns:res="using:ModShelf.Presentation.Resources"
             x:Class="ModShelf.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{Binding Title}" />

        <!-- Linux without a keyring: the credentials are in a file other programs running as the user can read. -->
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Classes="problem"
                   TextWrapping="Wrap"
                   Text="{x:Static res:Strings.CredentialsNotProtected}"
                   IsVisible="{Binding IsStoreUnprotected}" />

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />

        <TextBlock DockPanel.Dock="Top"
                   Classes="note message"
                   Classes.problem="{Binding IsEmptyTextAProblem}"
                   Text="{Binding EmptyText}" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountViewModel">
                        <views:AccountCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
