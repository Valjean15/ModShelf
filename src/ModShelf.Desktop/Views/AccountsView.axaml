<!-- The sites' accounts, in Settings › Accounts (ADR 0094): those that need one, those that work without one, and the
     sites that need none, each group under its heading. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Accounts"
             xmlns:views="using:ModShelf.Desktop.Views"
             xmlns:res="using:ModShelf.Presentation.Resources"
             x:Class="ModShelf.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <StackPanel Spacing="12">
        <!-- Linux without a keyring: the credentials are in a file other programs running as the user can read. -->
        <Border Classes="strip" IsVisible="{Binding IsStoreUnprotected}">
            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.CredentialsNotProtected}" />
        </Border>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />

        <TextBlock Classes="note message"
                   Classes.problem="{Binding IsEmptyTextAProblem}"
                   Text="{Binding EmptyText}" />

        <StackPanel Spacing="8" IsVisible="{Binding HasNeedOne}">
            <TextBlock Classes="subheading" Text="{x:Static res:Strings.AccountsNeedOne}" />
            <ItemsControl ItemsSource="{Binding NeedOne}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountViewModel">
                        <views:AccountRow />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasOptional}">
            <TextBlock Classes="subheading" Text="{x:Static res:Strings.AccountsOptional}" />
            <ItemsControl ItemsSource="{Binding Optional}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountViewModel">
                        <views:AccountRow />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasNoneNeeded}">
            <TextBlock Classes="subheading" Text="{x:Static res:Strings.AccountsNoneNeeded}" />
            <ItemsControl ItemsSource="{Binding NoneNeeded}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SiteWithoutAccountViewModel">
                        <Border Classes="card accountRow">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding SiteName}" />
                                <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding AboutText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
