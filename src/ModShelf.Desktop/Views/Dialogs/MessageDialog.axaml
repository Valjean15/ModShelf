<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:ModShelf.Desktop.Views.Dialogs"
        x:Class="ModShelf.Desktop.Views.Dialogs.MessageDialog"
        x:DataType="dialogs:MessageDialogContent"
        Title="{Binding Title}"
        Width="420"
        Classes="dialog">

    <DockPanel>
        <!-- Cancel first, so the main button sits in the corner. -->
        <StackPanel DockPanel.Dock="Bottom" Classes="dialogButtons">
            <Button Name="CancelButton"
                    IsCancel="True"
                    IsVisible="{Binding HasCancel}"
                    Content="{Binding CancelLabel}"
                    Click="OnCancel" />
            <Button Name="ConfirmButton"
                    Classes="accent"
                    IsDefault="True"
                    Content="{Binding ConfirmLabel}"
                    Click="OnConfirm" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="dialogTitle" Text="{Binding Title}" />
        <TextBlock Classes="note" Text="{Binding Message}" TextWrapping="Wrap" />
    </DockPanel>
</Window>
