<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModShelf.Presentation.ViewModels.Dialogs"
        x:Class="ModShelf.Desktop.Views.Dialogs.TextDialog"
        x:DataType="vm:TextQuestionViewModel"
        Title="{Binding Title}"
        Width="480"
        Classes="dialog">

    <Window.Styles>
        <!-- A secret, such as an API key, isn't shown as it's typed. -->
        <Style Selector="TextBox.secret">
            <Setter Property="PasswordChar" Value="•" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Cancel first, so the main button sits in the corner. -->
        <StackPanel DockPanel.Dock="Bottom" Classes="dialogButtons">
            <Button IsCancel="True"
                    Content="{Binding CancelLabel}"
                    Click="OnCancel" />
            <Button Classes="accent"
                    IsDefault="True"
                    Content="{Binding ConfirmLabel}"
                    Click="OnConfirm" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="dialogTitle" Text="{Binding Title}" />
        <StackPanel Spacing="12">
            <TextBlock Classes="note" Text="{Binding Message}" TextWrapping="Wrap" />

            <!-- A page that helps answer, such as where to find an API key. -->
            <Button HorizontalAlignment="Left"
                    Classes="quiet"
                    Content="{Binding HelpPageLabel}"
                    IsVisible="{Binding HasHelpPage}"
                    Command="{Binding OpenHelpPageCommand}" />
            <SelectableTextBlock Text="{Binding HelpPageProblem}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HelpPageProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBox Name="Answer"
                     Text="{Binding Text}"
                     Classes.secret="{Binding IsSecret}"
                     PlaceholderText="{Binding Hint}" />
        </StackPanel>
    </DockPanel>
</Window>
