<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModShelf.Presentation.ViewModels"
        x:Class="ModShelf.Desktop.Views.Dialogs.TextDialog"
        x:DataType="vm:TextQuestionViewModel"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- A secret, such as an API key, isn't shown as it's typed. -->
        <Style Selector="TextBox.secret">
            <Setter Property="PasswordChar" Value="•" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,24,0,0">
            <Button Classes="accent"
                    IsDefault="True"
                    Content="{Binding ConfirmLabel}"
                    Click="OnConfirm" />
            <Button IsCancel="True"
                    Content="{Binding CancelLabel}"
                    Click="OnCancel" />
        </StackPanel>
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

            <!-- A page that helps answer, such as where to find an API key. -->
            <Button Content="{Binding HelpPageLabel}" IsVisible="{Binding HasHelpPage}" Command="{Binding OpenHelpPageCommand}" />
            <SelectableTextBlock Text="{Binding HelpPageProblem}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HelpPageProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBox Name="Answer"
                     Text="{Binding Text}"
                     Classes.secret="{Binding IsSecret}"
                     PlaceholderText="{Binding Hint}" />
        </StackPanel>
    </DockPanel>
</Window>
