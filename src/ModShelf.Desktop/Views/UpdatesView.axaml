<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Updates"
             xmlns:res="using:ModShelf.Presentation.Resources"
             xmlns:views="using:ModShelf.Desktop.Views"
             xmlns:pictures="using:ModShelf.Desktop.Views.Pictures"
             x:Class="ModShelf.Desktop.Views.UpdatesView"
             x:DataType="vm:UpdatesViewModel">

    <!--
      The previews and buttons beside the heading, and an update's Skip and Download beside what it says; in a narrow
      window, below them. Their places are set here rather than on them, so the narrow window's can replace them.
    -->
    <UserControl.Styles>
        <Style Selector="StackPanel.tools">
            <Setter Property="Grid.Column" Value="1" />
        </Style>
        <Style Selector="StackPanel.updateButtons">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <ContainerQuery Name="UpdatesScreen" Query="max-width:620">
            <Style Selector="StackPanel.tools">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style Selector="StackPanel.updateButtons">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <DockPanel Container.Name="UpdatesScreen" Container.Sizing="Width">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Classes="heading" Margin="0" Text="{Binding Title}" />
                <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding SummaryText}" />
            </StackPanel>
            <StackPanel Classes="tools" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                <pictures:PreviewsPicker DataContext="{Binding Previews}" />
                <Button Content="{x:Static res:Strings.UpdatesCheckNow}" Command="{Binding CheckNowCommand}" />
                <Button Classes="accent"
                        Content="{Binding UpdateAllText}"
                        Command="{Binding UpdateAllCommand}"
                        IsVisible="{Binding HasUpdates}" />
            </StackPanel>
        </Grid>

        <ProgressBar DockPanel.Dock="Top" Margin="0,0,0,12" IsIndeterminate="True" IsVisible="{Binding IsChecking}" />

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Classes="note message"
                   Classes.problem="{Binding IsCheckResultAProblem}"
                   Text="{Binding CheckResult}" />

        <!-- What the last check couldn't check, and why: once, above the updates. -->
        <Border DockPanel.Dock="Top" Classes="strip" Margin="0,0,0,12" IsVisible="{Binding !!CheckFailures.Count}">
            <ItemsControl ItemsSource="{Binding CheckFailures}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Panel>
            <TextBlock Classes="note empty"
                       Text="{Binding NoUpdatesText}"
                       IsVisible="{Binding !HasUpdates}" />

            <!-- Each game: its heading with Update all, then its updates, each with its changes. -->
            <ScrollViewer IsVisible="{Binding HasUpdates}">
                <ItemsControl ItemsSource="{Binding Games}" Margin="0,0,16,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpdateGameViewModel">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="cover"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="8"
                                            Background="{Binding CoverHue, Converter={x:Static views:CoverBrushConverter.Instance}}">
                                        <Panel>
                                            <TextBlock FontSize="17" Text="{Binding Initial}" IsVisible="{Binding !Icon.HasFile}" />
                                            <pictures:ModImage File="{Binding Icon.File}"
                                                               DecodeWidth="80"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        </Panel>
                                    </Border>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" ItemSpacing="8">
                                        <TextBlock Classes="subheading" Text="{Binding Name}" />
                                        <Border Classes="site" IsVisible="{Binding ShowSite}"><TextBlock Text="{Binding SiteName}" /></Border>
                                        <TextBlock Classes="note" VerticalAlignment="Center" Text="{Binding CountText}" />
                                    </WrapPanel>
                                    <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Content="{Binding UpdateAllText}"
                                            Command="{Binding UpdateAllCommand}" />
                                </Grid>

                                <Border Classes="list">
                                    <ItemsControl ItemsSource="{Binding Updates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:UpdateViewModel">
                                                <Border Classes="file" Padding="16,12">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                                                        <!-- Its mod's thumbnail, while the screen shows them. -->
                                                        <Panel VerticalAlignment="Top" IsVisible="{Binding Picture.IsShown}">
                                                            <pictures:ModThumbnail DataContext="{Binding Picture}" />
                                                        </Panel>

                                                        <!-- Wrapping, so long names go to the next line rather than under the button. -->
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <WrapPanel ItemSpacing="10" LineSpacing="4">
                                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ModName}" />
                                                                <Border Classes="tag accent"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding ChangeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding ChangeText}" />
                                                                </Border>
                                                            </WrapPanel>
                                                            <WrapPanel ItemSpacing="12" LineSpacing="2">
                                                                <TextBlock Classes="note" FontSize="12.5" TextWrapping="Wrap" Text="{Binding FileName}" />
                                                                <TextBlock Classes="note" FontSize="12.5" Text="{Binding UploadedText}" />
                                                                <TextBlock Classes="note" FontSize="12.5" TextWrapping="Wrap" Text="{Binding ReplacesText}" />
                                                            </WrapPanel>

                                                            <!-- Its version's entry in its mod's changelog. -->
                                                            <StackPanel Margin="0,6,0,0" Spacing="2">
                                                                <TextBlock FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding ChangesTitle}"
                                                                           IsVisible="{Binding !!Changes.Count}" />
                                                                <ItemsControl Classes="bullets" ItemsSource="{Binding Changes}" />
                                                                <TextBlock Classes="note"
                                                                           FontSize="12.5"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding ChangesNote}"
                                                                           IsVisible="{Binding ChangesNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                            </StackPanel>

                                                            <TextBlock Classes="note message"
                                                                       Classes.problem="{Binding IsNoteAProblem}"
                                                                       Text="{Binding Note}" />
                                                        </StackPanel>

                                                        <StackPanel Classes="updateButtons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                                            <Button Classes="quiet"
                                                                    Content="{x:Static res:Strings.UpdateSkip}"
                                                                    Command="{Binding SkipCommand}"
                                                                    ToolTip.Tip="{x:Static res:Strings.UpdateSkipHint}" />
                                                            <Button Content="{x:Static res:Strings.FileDownload}" Command="{Binding DownloadCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
