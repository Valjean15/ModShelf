<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Updates"
             xmlns:res="using:ModShelf.Presentation.Resources"
             xmlns:pictures="using:ModShelf.Desktop.Views.Pictures"
             x:Class="ModShelf.Desktop.Views.UpdatesView"
             x:DataType="vm:UpdatesViewModel">

    <!--
      The previews beside the heading, and an update's buttons beside what it says; in a narrow window, below them.
      Their places are set here rather than on them, so the narrow window's can replace them.
    -->
    <UserControl.Styles>
        <Style Selector="pictures|PreviewsPicker#Previews">
            <Setter Property="Grid.Column" Value="1" />
        </Style>
        <Style Selector="StackPanel.actions">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <ContainerQuery Name="UpdatesScreen" Query="max-width:560">
            <Style Selector="pictures|PreviewsPicker#Previews">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style Selector="StackPanel.actions">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="-10,4,0,0" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <DockPanel Container.Name="UpdatesScreen" Container.Sizing="Width">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4" Margin="0,0,0,16">
                <TextBlock Classes="heading" Margin="0" Text="{Binding Title}" />
                <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding CheckedText}" />
            </StackPanel>
            <pictures:PreviewsPicker Name="Previews"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     DataContext="{Binding Previews}" />
            <Button Grid.Column="2"
                    VerticalAlignment="Top"
                    Classes="accent"
                    Content="{x:Static res:Strings.UpdatesCheckNow}"
                    Command="{Binding CheckNowCommand}" />
        </Grid>

        <ProgressBar DockPanel.Dock="Top" Margin="0,0,0,12" IsIndeterminate="True" IsVisible="{Binding IsChecking}" />

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Classes="note message"
                   Classes.problem="{Binding IsCheckResultAProblem}"
                   Text="{Binding CheckResult}" />

        <!-- What the last check couldn't check, and why: once, above the updates. -->
        <Border DockPanel.Dock="Top" Classes="strip" Margin="0,0,0,12" IsVisible="{Binding !!CheckFailures.Count}">
            <ItemsControl ItemsSource="{Binding CheckFailures}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Panel>
            <TextBlock Classes="note empty"
                       Text="{Binding NoUpdatesText}"
                       IsVisible="{Binding !HasUpdates}" />

            <Border Classes="list" VerticalAlignment="Top" IsVisible="{Binding HasUpdates}">
                <ListBox Classes="rows" ItemsSource="{Binding Updates}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpdateViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <!-- Its mod's thumbnail, while the screen shows them. -->
                                <Panel Margin="0,0,14,0" VerticalAlignment="Top" IsVisible="{Binding Picture.IsShown}">
                                    <pictures:ModThumbnail DataContext="{Binding Picture}" />
                                </Panel>

                                <!-- Wrapping, so long names go to the next line rather than under the buttons. -->
                                <StackPanel Grid.Column="1" Margin="0,0,16,0" Spacing="3">
                                    <WrapPanel ItemSpacing="8">
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ModName}" />
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Name}" />
                                    </WrapPanel>
                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding FileName}" />
                                    <WrapPanel ItemSpacing="14">
                                        <TextBlock Classes="note" Text="{Binding VersionText}" />
                                        <TextBlock Classes="note" Text="{Binding UploadedText}" />
                                        <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding ReplacesText}" />
                                    </WrapPanel>
                                    <TextBlock Classes="note message"
                                               Classes.problem="{Binding IsNoteAProblem}"
                                               Text="{Binding Note}" />
                                </StackPanel>

                                <StackPanel Classes="actions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="quiet" Content="{x:Static res:Strings.UpdateChanges}" Command="{Binding ToggleChangesCommand}" />
                                    <Button Content="{x:Static res:Strings.FileDownload}" Command="{Binding DownloadCommand}" />
                                </StackPanel>

                                <!-- The update's version in its mod's changelog. -->
                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,6,0,0"
                                        Padding="12,8"
                                        CornerRadius="8"
                                        Background="{DynamicResource ShelfRaisedBrush}"
                                        IsVisible="{Binding AreChangesShown}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="note"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ChangesNote}"
                                                   IsVisible="{Binding ChangesNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ItemsControl Classes="bullets" ItemsSource="{Binding Changes}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
