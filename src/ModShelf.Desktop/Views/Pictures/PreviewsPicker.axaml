<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Pictures"
             xmlns:res="using:ModShelf.Presentation.Resources"
             x:Class="ModShelf.Desktop.Views.Pictures.PreviewsPicker"
             x:DataType="vm:PreviewsViewModel">

    <!-- How a screen shows its mods: Off, Thumbnails, and Cards where the screen offers them. The label says when they're
         the shown game's own. -->
    <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Hint}">
        <TextBlock Classes="note" VerticalAlignment="Center" Text="{Binding Label}" />
        <Border Classes="segments">
            <StackPanel Orientation="Horizontal"
                        Spacing="2"
                        AutomationProperties.Name="{x:Static res:Strings.Previews}">
                <RadioButton Classes="segment" Content="{x:Static res:Strings.PreviewsOff}" IsChecked="{Binding IsOff}" />
                <RadioButton Classes="segment" Content="{x:Static res:Strings.PreviewsThumbnails}" IsChecked="{Binding IsThumbnails}" />
                <RadioButton Classes="segment"
                             Content="{x:Static res:Strings.PreviewsCards}"
                             IsChecked="{Binding IsCards}"
                             IsVisible="{Binding OffersCards}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
