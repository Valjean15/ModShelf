<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModShelf.Presentation.ViewModels"
        xmlns:res="using:ModShelf.Presentation.Resources"
        xmlns:views="using:ModShelf.Desktop.Views"
        x:Class="ModShelf.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1024" Height="640"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">

    <SplitView IsPaneOpen="{Binding IsSidebarOpen}"
               DisplayMode="CompactInline"
               CompactPaneLength="48"
               OpenPaneLength="208">
        <SplitView.Pane>
            <DockPanel>
                <Button DockPanel.Dock="Top"
                        Classes="sidebarToggle"
                        Command="{Binding ToggleSidebarCommand}"
                        ToolTip.Tip="{x:Static res:Strings.ToggleSidebar}">
                    <PathIcon Data="{StaticResource MenuIcon}" />
                </Button>
                <ListBox Classes="sidebar"
                         ItemsSource="{Binding Screens}"
                         SelectedItem="{Binding CurrentScreen}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScreenViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <!-- The badge sits on the icon, so it shows with the names hidden too. -->
                                <Panel>
                                    <PathIcon Data="{Binding Screen, Converter={x:Static views:ScreenIconConverter.Instance}}" />
                                    <Border Classes="badge" IsVisible="{Binding HasBadge}">
                                        <TextBlock Text="{Binding Badge}" />
                                    </Border>
                                </Panel>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </SplitView.Pane>

        <!-- App.axaml's data templates pick each screen's view. -->
        <ContentControl Margin="32,24" Content="{Binding CurrentScreen}" />
    </SplitView>
</Window>
