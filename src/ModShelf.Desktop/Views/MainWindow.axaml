<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModShelf.Presentation.ViewModels"
        xmlns:res="using:ModShelf.Presentation.Resources"
        xmlns:views="using:ModShelf.Desktop.Views"
        xmlns:pictures="using:ModShelf.Desktop.Views.Pictures"
        xmlns:quick="using:ModShelf.Desktop.Views.QuickSearch"
        xmlns:undo="using:ModShelf.Presentation.ViewModels.Undo"
        xmlns:quota="using:ModShelf.Presentation.ViewModels.Quota"
        x:Class="ModShelf.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1024" Height="640"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding QuickSearch.OpenCommand}" />
        <KeyBinding Gesture="Meta+K" Command="{Binding QuickSearch.OpenCommand}" />
    </Window.KeyBindings>

    <!-- The sidebar and the screen shown, with the undo bar at its bottom while it shows; quick search over both while
         it's open. -->
    <Panel>
        <SplitView IsPaneOpen="{Binding IsSidebarOpen}"
                   DisplayMode="CompactInline"
                   CompactPaneLength="56"
                   OpenPaneLength="216"
                   PaneBackground="{DynamicResource ShelfSidebarBrush}">
            <SplitView.Pane>
                <Border BorderBrush="{DynamicResource ShelfLineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- The toggle, then ModShelf's icon and name, which the collapsed sidebar hides. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,4,0,8">
                            <Button Classes="sidebarToggle"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.ToggleSidebar}"
                                    AutomationProperties.Name="{x:Static res:Strings.ToggleSidebar}">
                                <PathIcon Data="{StaticResource MenuIcon}" />
                            </Button>
                            <Image Source="/Assets/modshelf.png" Width="24" Height="24" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Static res:Strings.AppTitle}" />
                        </StackPanel>

                        <!-- Quick search's field, with its keys; collapsed, its icon alone. -->
                        <Button DockPanel.Dock="Top"
                                Classes="quickSearchOpen"
                                Classes.collapsed="{Binding !IsSidebarOpen}"
                                Command="{Binding QuickSearch.OpenCommand}"
                                ToolTip.Tip="{Binding QuickSearch.Tip}"
                                AutomationProperties.Name="{x:Static res:Strings.QuickSearchTitle}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Width="14" Height="14" Data="{StaticResource BrowseIcon}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="{x:Static res:Strings.QuickSearchField}"
                                           IsVisible="{Binding IsSidebarOpen}" />
                                <Border Grid.Column="2" Classes="keyCap" IsVisible="{Binding IsSidebarOpen}">
                                    <TextBlock Text="{Binding QuickSearch.Keys}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Settings at the bottom: its icon and name; collapsed, its icon. Its badge counts what to look at there: a
                             newer ModShelf, and accounts that need attention, which are inside it (ADR 0094). -->
                        <Button DockPanel.Dock="Bottom"
                                Classes="sidebarSettings"
                                Classes.selected="{Binding IsSettingsShown}"
                                Margin="6,8,6,10"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="{Binding SettingsTip}"
                                AutomationProperties.Name="{Binding SettingsTip}">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Panel>
                                    <PathIcon Data="{StaticResource SettingsIcon}" />
                                    <Border Classes="badge" IsVisible="{Binding HasSettingsBadge}">
                                        <TextBlock Text="{Binding SettingsBadge}" />
                                    </Border>
                                </Panel>
                                <TextBlock Text="{x:Static res:Strings.SettingsTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <ListBox Classes="sidebar"
                                 ItemsSource="{Binding SidebarScreens}"
                                 SelectedItem="{Binding SidebarScreen}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScreenViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <!-- The badge sits on the icon, so it shows with the names hidden too. -->
                                        <Panel>
                                            <PathIcon Data="{Binding Screen, Converter={x:Static views:ScreenIconConverter.Instance}}" />
                                            <Border Classes="badge" IsVisible="{Binding HasBadge}">
                                                <TextBlock Text="{Binding Badge}" />
                                            </Border>
                                        </Panel>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </SplitView.Pane>

            <Panel>
                <DockPanel>
                    <!-- While a site's requests run low: calm, or warm once they're used up, with when they renew. -->
                    <Border DockPanel.Dock="Top"
                            Classes="quotaStrip"
                            DataContext="{Binding Quota}"
                            x:DataType="quota:QuotaWarningViewModel"
                            Classes.usedUp="{Binding IsUsedUp}"
                            IsVisible="{Binding IsShown}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="{Binding Message}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button Grid.Column="1"
                                    Classes="pickerClear"
                                    Command="{Binding DismissCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.QuotaDismiss}"
                                    AutomationProperties.Name="{x:Static res:Strings.QuotaDismiss}">
                                <PathIcon Width="12" Height="12" Data="{StaticResource CloseIcon}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- App.axaml's data templates pick each screen's view. -->
                    <ContentControl Margin="32,28,32,24" Content="{Binding CurrentScreen}" />
                </DockPanel>

                <!-- What a change to the library did, with Undo, for ten seconds. -->
                <Border Classes="undoBar" DataContext="{Binding Undo}" x:DataType="undo:UndoBarViewModel" IsVisible="{Binding IsShown}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding Message}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1"
                                Classes="accent"
                                Content="{x:Static res:Strings.UndoAction}"
                                Command="{Binding UndoCommand}"
                                IsVisible="{Binding CanUndo}" />
                        <Button Grid.Column="2"
                                Classes="pickerClear"
                                Command="{Binding CloseCommand}"
                                ToolTip.Tip="{x:Static res:Strings.UndoDismiss}"
                                AutomationProperties.Name="{x:Static res:Strings.UndoDismiss}">
                            <PathIcon Width="12" Height="12" Data="{StaticResource CloseIcon}" />
                        </Button>
                    </Grid>
                </Border>
            </Panel>
        </SplitView>

        <quick:QuickSearchBox DataContext="{Binding QuickSearch}" />
    </Panel>
</Window>
