<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Settings"
             xmlns:views="using:ModShelf.Desktop.Views"
             xmlns:pictures="using:ModShelf.Desktop.Views.Pictures"
             xmlns:res="using:ModShelf.Presentation.Resources"
             x:Class="ModShelf.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- A folder pattern: its text, saved when the user says, with where a sample file goes or what's wrong. -->
        <DataTemplate x:Key="FolderPattern" x:DataType="vm:FolderPatternViewModel">
            <!-- The names share their column's width, as wide as the longest up to 160, so the boxes line up. -->
            <Grid RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="160" SharedSizeGroup="PatternName" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                <TextBox Grid.Column="1" FontFamily="{DynamicResource ShelfMonoFont}" FontSize="13" Text="{Binding Text}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Content="{x:Static res:Strings.SettingsSave}" Command="{Binding SaveCommand}" />
                    <Button Classes="quiet" Content="{x:Static res:Strings.SettingsUseDefault}" Command="{Binding UseDefaultCommand}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Classes="note"
                           TextWrapping="Wrap"
                           Text="{Binding Preview}"
                           IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Classes="problem"
                           TextWrapping="Wrap"
                           Text="{Binding Problem}"
                           IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
      The categories beside the settings; in a narrow window, above them, side by side, and a narrower search. Their
      places are set here rather than on them, so the narrow window's can replace them.
    -->
    <UserControl.Styles>
        <Style Selector="TextBox.search">
            <Setter Property="Width" Value="300" />
        </Style>
        <Style Selector="ScrollViewer.settings">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
        <Style Selector="StackPanel.gameList">
            <Setter Property="Grid.Column" Value="0" />
        </Style>
        <Style Selector="Panel.gamePage">
            <Setter Property="Grid.Column" Value="1" />
        </Style>
        <ContainerQuery Name="GamesCard" Query="max-width:600">
            <Style Selector="StackPanel.gameList">
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
            <Style Selector="Panel.gamePage">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="SettingsScreen" Query="max-width:640">
            <Style Selector="TextBox.search">
                <Setter Property="Width" Value="200" />
            </Style>
            <Style Selector="ListBox.categories">
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="ItemsPanel">
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter>
            </Style>
            <Style Selector="ScrollViewer.settings">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.RowSpan" Value="1" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <DockPanel Container.Name="SettingsScreen" Container.Sizing="Width">
        <!-- The heading, and the search across every category. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Classes="heading" Text="{Binding Title}" />
            <TextBox Grid.Column="1"
                     Classes="search"
                     VerticalAlignment="Top"
                     Text="{Binding SearchText}"
                     PlaceholderText="{x:Static res:Strings.SettingsSearchHint}"
                     AutomationProperties.Name="{x:Static res:Strings.SettingsSearchHint}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </Grid>

        <Border DockPanel.Dock="Top"
                Classes="strip"
                Margin="0,0,0,12"
                IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Problem}" />
        </Border>

        <!-- The categories, then the chosen one's settings, or a search's from every category. -->
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,*" ColumnSpacing="24">
            <ListBox Classes="categories"
                     VerticalAlignment="Top"
                     SelectionMode="AlwaysSelected"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     AutomationProperties.Name="{x:Static res:Strings.SettingsCategories}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                        <TextBlock Text="{Binding Name}" Classes.noMatches="{Binding !HasMatches}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Classes="settings">
                <!-- As wide as the screen allows, up to a comfortable width. -->
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*" MaxWidth="876" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="16" Margin="0,0,16,16" IsEnabled="{Binding IsLoaded}">
                        <TextBlock Classes="subheading" Text="{Binding SearchHeading}" IsVisible="{Binding IsSearching}" />
                        <TextBlock Classes="note"
                                   TextWrapping="Wrap"
                                   Text="{Binding NothingMatches}"
                                   IsVisible="{Binding NothingMatches, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <!-- The sites' accounts: the first category (ADR 0094). -->
                        <Panel IsVisible="{Binding AccountsSection.IsShown}">
                            <views:AccountsView DataContext="{Binding Accounts}" />
                        </Panel>

                        <Border Classes="card" IsVisible="{Binding ThemeSection.IsShown}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsAppearanceHeading}" />
                                <RadioButton GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeSystem}" IsChecked="{Binding IsSystemTheme}" />
                                <RadioButton GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeLight}" IsChecked="{Binding IsLightTheme}" />
                                <RadioButton GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeDark}" IsChecked="{Binding IsDarkTheme}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding WindowSection.IsShown}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsWindowHeading}" />
                                <StackPanel Spacing="8" IsEnabled="{Binding IsTrayAvailable}">
                                    <RadioButton GroupName="Close" Content="{x:Static res:Strings.SettingsCloseAsk}" IsChecked="{Binding IsAskOnClose}" />
                                    <RadioButton GroupName="Close" Content="{x:Static res:Strings.SettingsCloseToTray}" IsChecked="{Binding IsCloseToTray}" />
                                    <RadioButton GroupName="Close" Content="{x:Static res:Strings.SettingsCloseQuit}" IsChecked="{Binding IsQuitOnClose}" />
                                </StackPanel>
                                <TextBlock Classes="note"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.SettingsNoTray}"
                                           IsVisible="{Binding !IsTrayAvailable}" />
                            </StackPanel>
                        </Border>

                        <!-- How each screen shows mods: its name, what its previews cover, and its levels. -->
                        <Border Classes="card" IsVisible="{Binding PreviewsSection.IsShown}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="subheading" Text="{x:Static res:Strings.Previews}" />
                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsPreviewsNote}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ScreenPreviews}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <!-- The levels have no group name: each row's are grouped by their panel. -->
                                        <DataTemplate x:DataType="vm:ScreenPreviewsViewModel">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="2" AutomationProperties.Name="{Binding Name}">
                                                        <RadioButton Classes="segment" Content="{x:Static res:Strings.PreviewsRows}" IsChecked="{Binding IsRows}" />
                                                        <RadioButton Classes="segment" Content="{x:Static res:Strings.PreviewsThumbnails}" IsChecked="{Binding IsThumbnails}" />
                                                        <RadioButton Classes="segment"
                                                                     Content="{x:Static res:Strings.PreviewsCards}"
                                                                     IsChecked="{Binding IsCards}"
                                                                     IsVisible="{Binding OffersCards}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Pictures and mod details: each setting beside what it is, divided by lines. -->
                        <!-- A panel holds whether it shows: the card's own data is the part's. -->
                        <Panel IsVisible="{Binding PicturesSection.IsShown}">
                            <Border Classes="card" DataContext="{Binding Pictures}">
                                <StackPanel Spacing="14" x:DataType="vm:PicturesViewModel">
                                    <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsPicturesHeading}" />
                                    <Border Classes="strip" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="{Binding Problem}" />
                                    </Border>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SettingsSavedPictures}" />
                                            <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding SizeText}" />
                                            <ProgressBar Margin="0,4,0,0" MinHeight="6" Minimum="0" Maximum="100" Value="{Binding UsedPercent}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="note" VerticalAlignment="Center" Text="{x:Static res:Strings.SettingsPicturesAtMost}" />
                                            <ComboBox MinWidth="150" ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding SelectedSize}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Content="{x:Static res:Strings.SettingsPicturesClear}"
                                                Command="{Binding ClearCommand}" />
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource ShelfLineBrush}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SettingsModDetails}" />
                                            <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsModDetailsNote}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="note" VerticalAlignment="Center" Text="{x:Static res:Strings.SettingsModDetailsReadAgain}" />
                                            <ComboBox MinWidth="150" ItemsSource="{Binding AgeChoices}" SelectedItem="{Binding SelectedAge}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource ShelfLineBrush}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SettingsAdultContent}" />
                                            <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsAdultContentNote}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="170"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding AdultChoices}"
                                                  SelectedItem="{Binding SelectedAdult}"
                                                  AutomationProperties.Name="{x:Static res:Strings.SettingsAdultContent}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Panel>

                        <Border Classes="card" IsVisible="{Binding LibraryFolderSection.IsShown}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsLibraryHeading}" />
                                <views:LibraryFolderView />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding BrowserFolderSection.IsShown}">
                            <StackPanel Spacing="8" DataContext="{Binding BrowserFolder}" x:DataType="vm:BrowserFolderViewModel">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsBrowserFolderHeading}" />
                                <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsBrowserFolderNote}" />
                                <SelectableTextBlock FontFamily="{DynamicResource ShelfMonoFont}" FontSize="13" TextWrapping="Wrap" Text="{Binding Folder}" />
                                <TextBlock Classes="note" Text="{x:Static res:Strings.SettingsBrowserFolderIsSystems}" IsVisible="{Binding IsSystems}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Static res:Strings.SettingsChooseFolder}" Command="{Binding ChooseCommand}" />
                                    <Button Classes="quiet" Content="{x:Static res:Strings.SettingsUseSystemsDownloads}" Command="{Binding UseSystemsCommand}" />
                                </StackPanel>
                                <TextBlock Classes="note message problem" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding FolderPatternSection.IsShown}">
                            <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsFolderPatternHeading}" />
                                <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsFoldersNote}" />
                                <ContentControl Content="{Binding Folders}" ContentTemplate="{StaticResource FolderPattern}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding OldVersionsSection.IsShown}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsOldVersionsHeading}" />
                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsOldVersionsNote}" />
                                <RadioButton GroupName="OldVersions" Content="{x:Static res:Strings.SettingsKeepAll}" IsChecked="{Binding IsKeepAll}" />
                                <!-- In a TextBlock, so the _ of _archive shows rather than marking an access key. -->
                                <RadioButton GroupName="OldVersions" IsChecked="{Binding IsArchive}">
                                    <TextBlock Text="{x:Static res:Strings.SettingsArchive}" />
                                </RadioButton>
                                <!-- In a narrow window, the count goes under the choice, which wraps. -->
                                <WrapPanel ItemSpacing="12" LineSpacing="4">
                                    <RadioButton GroupName="OldVersions" IsChecked="{Binding IsKeepLatest}">
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsKeepLatest}" />
                                    </RadioButton>
                                    <NumericUpDown Minimum="1"
                                                   Maximum="{Binding MaxKeepCount}"
                                                   Increment="1"
                                                   FormatString="0"
                                                   Width="120"
                                                   Value="{Binding KeepCount}"
                                                   IsEnabled="{Binding IsKeepLatest}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding RescanSection.IsShown}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsRescanHeading}" />
                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsRescanNote}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{x:Static res:Strings.SettingsRescanButton}"
                                        Command="{Binding RescanCommand}" />
                            </Grid>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding UpdatesSection.IsShown}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsUpdatesHeading}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.SettingsInterval}" />
                                    <ComboBox MinWidth="220" ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding SelectedInterval}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:IntervalChoice">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox Content="{x:Static res:Strings.SettingsNotify}" IsChecked="{Binding NotifyOfUpdates}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding QuotaSection.IsShown}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsQuotaHeading}" />
                                <WrapPanel ItemSpacing="12" LineSpacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.SettingsQuotaWarn}" />
                                    <ComboBox MinWidth="160" ItemsSource="{Binding QuotaChoices}" SelectedItem="{Binding SelectedQuota}" />
                                </WrapPanel>
                                <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsQuotaNote}" />
                            </StackPanel>
                        </Border>

                        <!-- A panel holds whether it shows: the card's own data is the part's. -->
                        <Panel IsVisible="{Binding LinksSection.IsShown}">
                            <Border Classes="card" DataContext="{Binding Links}">
                                <StackPanel Spacing="8" x:DataType="vm:LinksViewModel">
                                    <TextBlock Classes="subheading" Text="{x:Static res:Strings.LinksHeading}" />
                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.LinksExplain}" />
                                    <views:LinkSitesView />
                                </StackPanel>
                            </Border>
                        </Panel>

                        <!-- AI agents: whether they may use ModShelf, connecting them, and the address the app serves them. -->
                        <Panel IsVisible="{Binding AgentsSection.IsShown}">
                            <Border Classes="card" DataContext="{Binding Agents}">
                                <StackPanel Spacing="16" x:DataType="vm:AgentsViewModel">
                                    <TextBlock Classes="subheading" Text="{x:Static res:Strings.AgentsHeading}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Static res:Strings.AgentsAllow}" />
                                            <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.AgentsAllowNote}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      VerticalAlignment="Top"
                                                      OnContent=""
                                                      OffContent=""
                                                      IsChecked="{Binding IsEnabled}"
                                                      AutomationProperties.Name="{x:Static res:Strings.AgentsAllow}" />
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Static res:Strings.AgentsConnectHeading}" />
                                        <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.AgentsConnectNote}" />
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0">
                                            <Button Classes="accent" Content="{x:Static res:Strings.AgentsCopyPrompt}" Command="{Binding CopyPromptCommand}" />
                                            <Button Content="{x:Static res:Strings.AgentsViewDetails}" Command="{Binding ShowDetailsCommand}" />
                                            <Button Content="{x:Static res:Strings.AgentsAddToClaudeDesktop}" Command="{Binding AddToClaudeDesktopCommand}" />
                                        </WrapPanel>
                                        <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding Done}" IsVisible="{Binding Done, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding ClaudeDesktopNote}" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Classes="note" Text="{x:Static res:Strings.AgentsCommandLabel}" />
                                            <SelectableTextBlock Grid.Column="1" FontFamily="{DynamicResource ShelfMonoFont}" FontSize="12" TextWrapping="Wrap" Text="{Binding CommandNote}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Static res:Strings.AgentsAddressHeading}" />
                                        <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.AgentsAddressNote}" />
                                        <TextBlock Classes="note" Classes.problem="{Binding HasStatusProblem}" TextWrapping="Wrap" Text="{Binding Status}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.AgentsPortLabel}" />
                                            <TextBox Width="96"
                                                     FontFamily="{DynamicResource ShelfMonoFont}"
                                                     Text="{Binding PortText}"
                                                     AutomationProperties.Name="{x:Static res:Strings.AgentsPortLabel}" />
                                            <Button Content="{x:Static res:Strings.AgentsPortSave}" Command="{Binding SavePortCommand}" />
                                        </StackPanel>
                                        <TextBlock Classes="note" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static res:Strings.AgentsProcessesNote}" />
                                    </StackPanel>

                                    <TextBlock Classes="problem" TextWrapping="Wrap" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </Border>
                        </Panel>

                        <!-- The games, and the chosen one's own settings beside them; in a narrow card, below them. -->
                        <Border Classes="card" IsVisible="{Binding GamesSection.IsShown}" Container.Name="GamesCard" Container.Sizing="Width">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsGamesHeading}" />
                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsGamesNote}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                                    <StackPanel Classes="gameList" Spacing="8">
                                        <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsGamesNone}" IsVisible="{Binding HasNoGames}" />
                                        <ListBox Classes="games"
                                                 ItemsSource="{Binding Games}"
                                                 SelectedItem="{Binding SelectedGame}"
                                                 IsVisible="{Binding !HasNoGames}"
                                                 AutomationProperties.Name="{x:Static res:Strings.SettingsCategoryGames}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GameRowViewModel">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Border Classes="cover"
                                                                Width="44"
                                                                Height="26"
                                                                CornerRadius="4"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding CoverHue, Converter={x:Static views:CoverBrushConverter.Instance}}">
                                                            <Panel>
                                                                <TextBlock FontSize="13" Text="{Binding Initial}" IsVisible="{Binding !Cover.HasFile}" />
                                                                <pictures:ModImage File="{Binding Cover.File}"
                                                                                   DecodeWidth="180"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Classes="gameName" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                            <WrapPanel ItemSpacing="8" LineSpacing="2">
                                                                <Border Classes="site" IsVisible="{Binding ShowSite}"><TextBlock Text="{Binding SiteName}" /></Border>
                                                                <TextBlock Classes="note" FontSize="12.5" TextTrimming="CharacterEllipsis" Text="{Binding Note}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="{x:Static res:Strings.SettingsAddGame}" Command="{Binding AddGameCommand}" />
                                    </StackPanel>

                                    <Panel Classes="gamePage" IsVisible="{Binding Game, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Border Classes="gamePage" DataContext="{Binding Game}">
                                            <StackPanel x:DataType="vm:GameSettingsViewModel" Spacing="18">
                                                <WrapPanel Margin="0,0,0,4" ItemSpacing="10" LineSpacing="4">
                                                    <TextBlock Classes="subheading" Margin="0" TextWrapping="Wrap" Text="{Binding Name}" />
                                                    <Border Classes="site" IsVisible="{Binding ShowSite}"><TextBlock Text="{Binding SiteName}" /></Border>
                                                </WrapPanel>
                                                <TextBlock Classes="problem" TextWrapping="Wrap" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                <!-- The same game on another site: said, and its settings offered, never taken by itself. -->
                                                <StackPanel Spacing="6" IsVisible="{Binding HasAlsoOn}">
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding AlsoOnText}" />
                                                    <ItemsControl ItemsSource="{Binding CopyChoices}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemSpacing="8" LineSpacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:GameCopyViewModel">
                                                                <Button Content="{Binding Text}" Command="{Binding CopyCommand}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- The game's folder: the library's, or its own; choosing another moves its files there. -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                            <TextBlock Classes="settingName" Text="{x:Static res:Strings.GameFolderHeading}" />
                                                            <Border Classes="pill" IsVisible="{Binding !HasOwnRoot}"><TextBlock Text="{x:Static res:Strings.GameFolderUsesLibrary}" /></Border>
                                                            <Border Classes="pill own" IsVisible="{Binding HasOwnRoot}"><TextBlock Text="{x:Static res:Strings.GameFolderOwnPill}" /></Border>
                                                        </WrapPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Classes="quiet" Content="{x:Static res:Strings.GameFolderMoveBack}" Command="{Binding MoveBackCommand}" IsVisible="{Binding HasOwnRoot}" />
                                                            <Button Content="{x:Static res:Strings.GameFolderChoose}" Command="{Binding ChooseFolderCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding FolderText}" />
                                                    <SelectableTextBlock FontFamily="{DynamicResource ShelfMonoFont}" FontSize="13" TextWrapping="Wrap" Text="{Binding FolderPath}" />
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding FolderNote}" IsVisible="{Binding FolderNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </StackPanel>

                                                <!-- Folder pattern. -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                            <TextBlock Classes="settingName" Text="{x:Static res:Strings.SettingsFolderPatternHeading}" />
                                                            <Border Classes="pill" IsVisible="{Binding !HasOwnFolders}"><TextBlock Text="{x:Static res:Strings.SettingUsesDefault}" /></Border>
                                                            <Border Classes="pill own" IsVisible="{Binding HasOwnFolders}"><TextBlock Text="{x:Static res:Strings.SettingOverridden}" /></Border>
                                                        </WrapPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static res:Strings.SettingOverride}" Command="{Binding OverrideFoldersCommand}" IsVisible="{Binding !HasOwnFolders}" />
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Classes="quiet" Content="{x:Static res:Strings.SettingUseDefault}" Command="{Binding Folders.RemoveCommand}" IsVisible="{Binding HasOwnFolders}" />
                                                    </Grid>
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.GameFoldersNote}" />
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding EveryGamesFolders}" />
                                                    <Panel IsVisible="{Binding HasOwnFolders}">
                                                        <Grid DataContext="{Binding Folders}" x:DataType="vm:FolderPatternViewModel" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4" Margin="0,4,0,0">
                                                            <TextBox FontFamily="{DynamicResource ShelfMonoFont}" FontSize="13" Text="{Binding Text}" />
                                                            <Button Grid.Column="1" Content="{x:Static res:Strings.SettingsSave}" Command="{Binding SaveCommand}" />
                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="note" TextWrapping="Wrap" Text="{Binding Preview}" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="problem" TextWrapping="Wrap" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Grid>
                                                    </Panel>
                                                </StackPanel>

                                                <!-- Old versions. -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                            <TextBlock Classes="settingName" Text="{x:Static res:Strings.SettingsOldVersionsHeading}" />
                                                            <Border Classes="pill" IsVisible="{Binding !HasOwnOldVersions}"><TextBlock Text="{x:Static res:Strings.SettingUsesDefault}" /></Border>
                                                            <Border Classes="pill own" IsVisible="{Binding HasOwnOldVersions}"><TextBlock Text="{x:Static res:Strings.SettingOverridden}" /></Border>
                                                        </WrapPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static res:Strings.SettingOverride}" Command="{Binding OverrideOldVersionsCommand}" IsVisible="{Binding !HasOwnOldVersions}" />
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Classes="quiet" Content="{x:Static res:Strings.SettingUseDefault}" Command="{Binding UseDefaultOldVersionsCommand}" IsVisible="{Binding HasOwnOldVersions}" />
                                                    </Grid>
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.GameOldVersionsNote}" />
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding EveryGamesOldVersions}" />
                                                    <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasOwnOldVersions}">
                                                        <RadioButton GroupName="GameOldVersions" IsChecked="{Binding IsKeepAll}">
                                                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsKeepAll}" />
                                                        </RadioButton>
                                                        <!-- In a TextBlock, so the _ of _archive shows rather than marking an access key. -->
                                                        <RadioButton GroupName="GameOldVersions" IsChecked="{Binding IsArchive}">
                                                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsArchive}" />
                                                        </RadioButton>
                                                        <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                            <RadioButton GroupName="GameOldVersions" IsChecked="{Binding IsKeepLatest}">
                                                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsKeepLatest}" />
                                                            </RadioButton>
                                                            <NumericUpDown Minimum="1"
                                                                           Maximum="{Binding MaxKeepCount}"
                                                                           Increment="1"
                                                                           FormatString="0"
                                                                           Width="120"
                                                                           Value="{Binding KeepCount}"
                                                                           IsEnabled="{Binding IsKeepLatest}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Update checks. -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                            <TextBlock Classes="settingName" Text="{x:Static res:Strings.GameChecksHeading}" />
                                                            <Border Classes="pill" IsVisible="{Binding !HasOwnChecks}"><TextBlock Text="{x:Static res:Strings.SettingUsesDefault}" /></Border>
                                                            <Border Classes="pill own" IsVisible="{Binding HasOwnChecks}"><TextBlock Text="{x:Static res:Strings.SettingOverridden}" /></Border>
                                                        </WrapPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static res:Strings.SettingOverride}" Command="{Binding OverrideChecksCommand}" IsVisible="{Binding !HasOwnChecks}" />
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Classes="quiet" Content="{x:Static res:Strings.SettingUseDefault}" Command="{Binding UseDefaultChecksCommand}" IsVisible="{Binding HasOwnChecks}" />
                                                    </Grid>
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding EveryGamesChecks}" />
                                                    <StackPanel Spacing="8" Margin="0,4,0,0" IsVisible="{Binding HasOwnChecks}">
                                                        <CheckBox Content="{x:Static res:Strings.GameChecksOn}" IsChecked="{Binding ChecksUpdates}" />
                                                        <WrapPanel ItemSpacing="12" LineSpacing="4" IsVisible="{Binding ChecksUpdates}">
                                                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.GameIntervalLabel}" />
                                                            <ComboBox MinWidth="240" ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding SelectedInterval}" />
                                                        </WrapPanel>
                                                        <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.GameChecksOffNote}" IsVisible="{Binding !ChecksUpdates}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Notices. -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                            <TextBlock Classes="settingName" Text="{x:Static res:Strings.GameNoticesHeading}" />
                                                            <Border Classes="pill" IsVisible="{Binding !HasOwnNotices}"><TextBlock Text="{x:Static res:Strings.SettingUsesDefault}" /></Border>
                                                            <Border Classes="pill own" IsVisible="{Binding HasOwnNotices}"><TextBlock Text="{x:Static res:Strings.SettingOverridden}" /></Border>
                                                        </WrapPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static res:Strings.SettingOverride}" Command="{Binding OverrideNoticesCommand}" IsVisible="{Binding !HasOwnNotices}" />
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Classes="quiet" Content="{x:Static res:Strings.SettingUseDefault}" Command="{Binding UseDefaultNoticesCommand}" IsVisible="{Binding HasOwnNotices}" />
                                                    </Grid>
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding EveryGamesNotices}" />
                                                    <CheckBox Margin="0,4,0,0" Content="{x:Static res:Strings.GameNoticesOn}" IsChecked="{Binding Notify}" IsVisible="{Binding HasOwnNotices}" />
                                                </StackPanel>

                                                <!-- Previews on the game's Library page and in Browse. -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                            <TextBlock Classes="settingName" Text="{x:Static res:Strings.GamePreviewsHeading}" />
                                                            <Border Classes="pill" IsVisible="{Binding !HasOwnPreviews}"><TextBlock Text="{x:Static res:Strings.SettingUsesDefault}" /></Border>
                                                            <Border Classes="pill own" IsVisible="{Binding HasOwnPreviews}"><TextBlock Text="{x:Static res:Strings.SettingOverridden}" /></Border>
                                                        </WrapPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static res:Strings.SettingOverride}" Command="{Binding OverridePreviewsCommand}" IsVisible="{Binding !HasOwnPreviews}" />
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Classes="quiet" Content="{x:Static res:Strings.SettingUseDefault}" Command="{Binding UseDefaultPreviewsCommand}" IsVisible="{Binding HasOwnPreviews}" />
                                                    </Grid>
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.GamePreviewsNote}" />
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding EveryGamesPreviews}" />
                                                    <Border Classes="segments" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding HasOwnPreviews}">
                                                        <StackPanel Orientation="Horizontal" Spacing="2" AutomationProperties.Name="{x:Static res:Strings.GamePreviewsHeading}">
                                                            <RadioButton Classes="segment" GroupName="GamePreviews" Content="{x:Static res:Strings.PreviewsRows}" IsChecked="{Binding IsPreviewsOff}" />
                                                            <RadioButton Classes="segment" GroupName="GamePreviews" Content="{x:Static res:Strings.PreviewsThumbnails}" IsChecked="{Binding IsPreviewsThumbnails}" />
                                                            <RadioButton Classes="segment" GroupName="GamePreviews" Content="{x:Static res:Strings.PreviewsCards}" IsChecked="{Binding IsPreviewsCards}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- How Browse starts. -->
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                            <TextBlock Classes="settingName" Text="{x:Static res:Strings.GameBrowseHeading}" />
                                                            <Border Classes="pill" IsVisible="{Binding !HasOwnBrowse}"><TextBlock Text="{x:Static res:Strings.SettingUsesDefault}" /></Border>
                                                            <Border Classes="pill own" IsVisible="{Binding HasOwnBrowse}"><TextBlock Text="{x:Static res:Strings.SettingOverridden}" /></Border>
                                                        </WrapPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Static res:Strings.SettingOverride}" Command="{Binding OverrideBrowseCommand}" IsVisible="{Binding !HasOwnBrowse}" />
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Classes="quiet" Content="{x:Static res:Strings.SettingUseDefault}" Command="{Binding UseDefaultBrowseCommand}" IsVisible="{Binding HasOwnBrowse}" />
                                                    </Grid>
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.GameBrowseNote}" />
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding EveryGamesBrowse}" />
                                                    <WrapPanel ItemSpacing="16" LineSpacing="8" Margin="0,4,0,0" IsVisible="{Binding HasOwnBrowse}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.GameBrowseOrder}" />
                                                            <ComboBox MinWidth="200" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanSearchByUpdated}">
                                                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.GameBrowseUpdated}" />
                                                            <ComboBox MinWidth="180" ItemsSource="{Binding TimeWindows}" SelectedItem="{Binding SelectedTimeWindow}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.GameBrowsePageSize}" />
                                                            <ComboBox MinWidth="120" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding SelectedPageSize}" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Hiding the game. -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="settingName" Text="{x:Static res:Strings.GameHideHeading}" />
                                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.GameHideNote}" />
                                                    <CheckBox Margin="0,4,0,0" IsChecked="{Binding IsHidden}">
                                                        <TextBlock TextWrapping="Wrap" Text="{Binding HideText}" />
                                                    </CheckBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" IsVisible="{Binding AboutSection.IsShown}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="subheading" Text="{x:Static res:Strings.AboutHeading}" />
                                <SelectableTextBlock Text="{Binding About.VersionText}" />

                                <!-- ModShelf's own updates: where they stand, what's new, and the next step. -->
                                <StackPanel Spacing="8" DataContext="{Binding AppUpdate}" x:DataType="vm:AppUpdateViewModel">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{Binding Status}"
                                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <ScrollViewer MaxHeight="160" IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <SelectableTextBlock Classes="note" TextWrapping="Wrap" Text="{Binding Notes}" />
                                    </ScrollViewer>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsDownloading}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsInstalled}">
                                        <Button Content="{x:Static res:Strings.AppUpdateCheck}" Command="{Binding CheckCommand}" />
                                        <Button Classes="accent"
                                                Content="{x:Static res:Strings.AppUpdateDownload}"
                                                Command="{Binding DownloadCommand}"
                                                IsVisible="{Binding Found, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <Button Classes="accent"
                                                Content="{x:Static res:Strings.AppUpdateRestart}"
                                                Command="{Binding RestartCommand}"
                                                IsVisible="{Binding Ready, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                    <TextBlock Classes="problem"
                                               TextWrapping="Wrap"
                                               Text="{Binding Problem}"
                                               IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <CheckBox Content="{x:Static res:Strings.AppUpdateCheckAtStart}"
                                          IsChecked="{Binding CheckForAppUpdates}"
                                          IsVisible="{Binding AppUpdate.IsInstalled}" />

                                <StackPanel Spacing="8" DataContext="{Binding About}" x:DataType="vm:AboutViewModel">
                                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.AboutBugReport}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{x:Static res:Strings.AboutCopyDiagnostics}" Command="{Binding CopyDiagnosticsCommand}" />
                                        <Button Content="{x:Static res:Strings.AboutOpenLogFolder}" Command="{Binding OpenLogFolderCommand}" />
                                    </StackPanel>
                                    <TextBlock Classes="note message" Classes.problem="{Binding IsNoteAProblem}" Text="{Binding Note}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8" IsVisible="{Binding AboutSection.IsShown}">
                            <SelectableTextBlock Classes="note" TextWrapping="Wrap" Text="{Binding KeptInText}" />
                            <Border Classes="strip" IsVisible="{Binding IsStoreUnprotected}">
                                <TextBlock Text="{x:Static res:Strings.CredentialsNotProtected}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
