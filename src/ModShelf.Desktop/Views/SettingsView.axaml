<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModShelf.Presentation.ViewModels.Settings"
             xmlns:views="using:ModShelf.Desktop.Views"
             xmlns:res="using:ModShelf.Presentation.Resources"
             x:Class="ModShelf.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- A folder pattern: its text, saved when the user says, with where a sample file goes or what's wrong. -->
        <DataTemplate x:Key="FolderPattern" x:DataType="vm:FolderPatternViewModel">
            <!-- The names share their column's width, as wide as the longest up to 160, so the boxes line up. -->
            <Grid RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="160" SharedSizeGroup="PatternName" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                <TextBox Grid.Column="1" FontFamily="{DynamicResource ShelfMonoFont}" FontSize="13" Text="{Binding Text}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Content="{x:Static res:Strings.SettingsSave}" Command="{Binding SaveCommand}" />
                    <Button Classes="quiet" Content="{x:Static res:Strings.SettingsUseDefault}" Command="{Binding UseDefaultCommand}" IsVisible="{Binding !IsGame}" />
                    <Button Classes="quiet" Content="{x:Static res:Strings.SettingsRemoveGame}" Command="{Binding RemoveCommand}" IsVisible="{Binding IsGame}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Classes="note"
                           TextWrapping="Wrap"
                           Text="{Binding Preview}"
                           IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Classes="problem"
                           TextWrapping="Wrap"
                           Text="{Binding Problem}"
                           IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{Binding Title}" />

        <Border DockPanel.Dock="Top"
                Classes="strip"
                Margin="0,0,0,12"
                IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Problem}" />
        </Border>

        <ScrollViewer>
            <!-- As wide as the screen allows, up to a comfortable width. -->
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" MaxWidth="876" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="16" Margin="0,0,16,16" IsEnabled="{Binding IsLoaded}">

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsLibraryHeading}" />
                            <views:LibraryFolderView />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
                            <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsFoldersHeading}" />
                            <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsFoldersNote}" />
                            <ContentControl Content="{Binding Folders}" ContentTemplate="{StaticResource FolderPattern}" />
                            <ItemsControl ItemsSource="{Binding GameFolders}" ItemTemplate="{StaticResource FolderPattern}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Content="{x:Static res:Strings.SettingsAddGame}" Command="{Binding AddGameCommand}" />
                            <TextBlock Classes="problem"
                                       TextWrapping="Wrap"
                                       Text="{Binding GameFoldersNote}"
                                       IsVisible="{Binding GameFoldersNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsOldVersionsHeading}" />
                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SettingsOldVersionsNote}" />
                            <RadioButton GroupName="OldVersions" Content="{x:Static res:Strings.SettingsKeepAll}" IsChecked="{Binding IsKeepAll}" />
                            <!-- In a TextBlock, so the _ of _archive shows rather than marking an access key. -->
                            <RadioButton GroupName="OldVersions" IsChecked="{Binding IsArchive}">
                                <TextBlock Text="{x:Static res:Strings.SettingsArchive}" />
                            </RadioButton>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <RadioButton GroupName="OldVersions" Content="{x:Static res:Strings.SettingsKeepLatest}" IsChecked="{Binding IsKeepLatest}" />
                                <NumericUpDown Minimum="1"
                                               Maximum="{Binding MaxKeepCount}"
                                               Increment="1"
                                               FormatString="0"
                                               Width="120"
                                               Value="{Binding KeepCount}"
                                               IsEnabled="{Binding IsKeepLatest}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsUpdatesHeading}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.SettingsInterval}" />
                                <ComboBox MinWidth="220" ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding SelectedInterval}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IntervalChoice">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Content="{x:Static res:Strings.SettingsNotify}" IsChecked="{Binding NotifyOfUpdates}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsAppearanceHeading}" />
                            <RadioButton GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeSystem}" IsChecked="{Binding IsSystemTheme}" />
                            <RadioButton GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeLight}" IsChecked="{Binding IsLightTheme}" />
                            <RadioButton GroupName="Theme" Content="{x:Static res:Strings.SettingsThemeDark}" IsChecked="{Binding IsDarkTheme}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subheading" Text="{x:Static res:Strings.SettingsWindowHeading}" />
                            <StackPanel Spacing="8" IsEnabled="{Binding IsTrayAvailable}">
                                <RadioButton GroupName="Close" Content="{x:Static res:Strings.SettingsCloseAsk}" IsChecked="{Binding IsAskOnClose}" />
                                <RadioButton GroupName="Close" Content="{x:Static res:Strings.SettingsCloseToTray}" IsChecked="{Binding IsCloseToTray}" />
                                <RadioButton GroupName="Close" Content="{x:Static res:Strings.SettingsCloseQuit}" IsChecked="{Binding IsQuitOnClose}" />
                            </StackPanel>
                            <TextBlock Classes="note"
                                       TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.SettingsNoTray}"
                                       IsVisible="{Binding !IsTrayAvailable}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" DataContext="{Binding Links}">
                        <StackPanel Spacing="8" x:DataType="vm:LinksViewModel">
                            <TextBlock Classes="subheading" Text="{x:Static res:Strings.LinksHeading}" />
                            <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.LinksExplain}" />
                            <views:LinkSitesView />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="subheading" Text="{x:Static res:Strings.AboutHeading}" />
                            <SelectableTextBlock Text="{Binding About.VersionText}" />

                            <!-- ModShelf's own updates: where they stand, what's new, and the next step. -->
                            <StackPanel Spacing="8" DataContext="{Binding AppUpdate}" x:DataType="vm:AppUpdateViewModel">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{Binding Status}"
                                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ScrollViewer MaxHeight="160" IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <SelectableTextBlock Classes="note" TextWrapping="Wrap" Text="{Binding Notes}" />
                                </ScrollViewer>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsDownloading}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsInstalled}">
                                    <Button Content="{x:Static res:Strings.AppUpdateCheck}" Command="{Binding CheckCommand}" />
                                    <Button Classes="accent"
                                            Content="{x:Static res:Strings.AppUpdateDownload}"
                                            Command="{Binding DownloadCommand}"
                                            IsVisible="{Binding Found, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <Button Classes="accent"
                                            Content="{x:Static res:Strings.AppUpdateRestart}"
                                            Command="{Binding RestartCommand}"
                                            IsVisible="{Binding Ready, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                                <TextBlock Classes="problem"
                                           TextWrapping="Wrap"
                                           Text="{Binding Problem}"
                                           IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <CheckBox Content="{x:Static res:Strings.AppUpdateCheckAtStart}"
                                      IsChecked="{Binding CheckForAppUpdates}"
                                      IsVisible="{Binding AppUpdate.IsInstalled}" />

                            <StackPanel Spacing="8" DataContext="{Binding About}" x:DataType="vm:AboutViewModel">
                                <TextBlock Classes="note" TextWrapping="Wrap" Text="{x:Static res:Strings.AboutBugReport}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Static res:Strings.AboutCopyDiagnostics}" Command="{Binding CopyDiagnosticsCommand}" />
                                    <Button Content="{x:Static res:Strings.AboutOpenLogFolder}" Command="{Binding OpenLogFolderCommand}" />
                                </StackPanel>
                                <TextBlock Classes="note message" Classes.problem="{Binding IsNoteAProblem}" Text="{Binding Note}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <SelectableTextBlock Classes="note" TextWrapping="Wrap" Text="{Binding KeptInText}" />
                        <Border Classes="strip" IsVisible="{Binding IsStoreUnprotected}">
                            <TextBlock Text="{x:Static res:Strings.CredentialsNotProtected}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
